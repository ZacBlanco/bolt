+struct Boundary {
+  size_t begin = 0;
+  size_t end = 0;
+};
+
+template <class T>
+static T alignValue(T n, T val) {
+  return ((n + (val - 1)) / val) * val;
+}
+
+static size_t compuateBoundaryDelta(
+    const size_t& total_remaining,
+    const size_t& k,
+    const Boundary& run_boundary) {
+  const auto runRemaining = run_boundary.end - run_boundary.begin;
+  return std::min(alignValue(total_remaining, k) / k, runRemaining);
+}
+
+// This implements the K-way merge from the DuckDB blog post, but
+// just for the specific case of 2 vectors.
+// Arguments:
+//   - a: input ordered container
+//   - b: 2nd input ordered container.
+//   - threadIdx: 0-indexed identifier of the thread computing this partition
+//   - totalPartitions: the total number of partitions that will be computed
+//   (this method computes just one)
+//   - op: reference to parent
+//   - lastPartition: the previous partition's computed values
+static std::pair<uint64_t, uint64_t> calculatePartitionPoint_DDB(
+    const std::shared_ptr<OrderedContainer>& a,
+    const std::shared_ptr<OrderedContainer>& b,
+    const uint32_t threadIdx,
+    const uint32_t totalPartitions,
+    const SortBufferMergePath* op,
+    const std::pair<uint64_t, uint64_t>& lastPartition) {
+  auto partitionSize = (a->totalRecords_ + b->totalRecords_) / totalPartitions;
+  size_t totalRemaining = (threadIdx + 1) * partitionSize;
+  std::vector<std::shared_ptr<OrderedContainer>> runs = {a, b};
+  std::vector<size_t> activeRunIdxs = {0, 1};
+  totalRemaining -= lastPartition.first; // index of a's last boundary
+  totalRemaining -= lastPartition.second; // index of b's last boundary
+  std::vector<Boundary> runBoundaries = {
+      {.begin = lastPartition.first, .end = a->totalRecords_},
+      {.begin = lastPartition.second, .end = b->totalRecords_}};
+  std::shared_ptr<PinnedRowContainer> minContainerPinned;
+  uint64_t minContainerLastInnerContainerIdx;
+
+  // while we haven't assigned all records in this partition
+  while (totalRemaining != 0) {
+    const size_t k = runs.size();
+    auto minIdx = activeRunIdxs[0];
+    // the minimum amount to move up the pointer for each run
+    auto minDelta =
+        compuateBoundaryDelta(totalRemaining, k, runBoundaries[minIdx]);
+    size_t minRowValueIdx = runBoundaries[minIdx].begin + minDelta - 1;
+    size_t minValueRunIdx = minIdx;
+    for (size_t i = 1; i < activeRunIdxs.size(); i++) {
+      const auto& activeRunIdx = activeRunIdxs[i];
+      const auto& runBoundary = runBoundaries[activeRunIdx];
+      const auto runDelta =
+          compuateBoundaryDelta(totalRemaining, k, runBoundary);
+      auto runValueIdx = runBoundary.begin + runDelta - 1;
+      uint64_t bContainerIdx = 0;
+      std::shared_ptr<PinnedRowContainer> bContainer = nullptr;
+      auto compare = compareGlobal(
+          minRowValueIdx,
+          runs[minValueRunIdx],
+          minContainerLastInnerContainerIdx,
+          minContainerPinned,
+          runValueIdx,
+          runs[activeRunIdx],
+          bContainerIdx,
+          bContainer,
+          op);
+      if (compare == 1) {
+        minIdx = activeRunIdx;
+        minDelta = runDelta;
+        minRowValueIdx = minValueRunIdx = activeRunIdx;
+        minContainerLastInnerContainerIdx = bContainerIdx;
+      }
+    }
+
+    auto& minRunBoundary = runBoundaries[minIdx];
+    minRunBoundary.begin += minDelta;
+
+    if (minRunBoundary.begin == minRunBoundary.end) {
+      activeRunIdxs.erase(std::ranges::find(activeRunIdxs, minIdx));
+    }
+
+    VELOX_CHECK(minDelta <= totalRemaining);
+    totalRemaining -= minDelta;
+  }
+
+  // End of boundary is meaningless now, just set equal to begin so there's no
+  // confusion
+  for (auto& runBoundary : runBoundaries) {
+    runBoundary.end = runBoundary.begin;
+  }
+  return {runBoundaries[0].end, runBoundaries[1].end};
+}
