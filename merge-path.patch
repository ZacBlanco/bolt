+
+using namespace facebook::velox;
+using namespace facebook::velox::exec;
+using namespace facebook::velox::exec::test;
+
+class OrderByRowContainerTest : public OperatorTestBase {
+ public:
+
+  void TearDown() override {
+    OperatorTestBase::TearDown();
+    container_.reset();
+    pool_.reset();
+  }
+
+  void SetUp() override {
+    OperatorTestBase::SetUp();
+    pool_.reset();
+    container_.reset();
+    pool_ = memory::memoryManager()->addLeafPool();
+
+    // Create a simple row type for testing
+    rowType_ = ROW({{"c0", INTEGER()}, {"c1", VARCHAR()}});
+
+    // Create sort column indices and flags
+    sortColumnIndices_ = {0}; // Sort by first column (c0)
+    sortCompareFlags_ = {CompareFlags{true, true}}; // ASC, NULLS FIRST
+
+    // Create OrderByRowContainer with small memory limit for testing eviction
+    container_ = std::make_unique<OrderByRowContainer>(
+        sortColumnIndices_,
+        sortCompareFlags_,
+        rowType_,
+        pool_,
+        1024 * 1024); // 1MB limit
+  }
+
+  // Helper method to create test data
+  RowVectorPtr createTestData(int numRows) {
+    std::vector<int32_t> c0Values;
+
+    auto c1Values = BaseVector::create<FlatVector<StringView>>(VARCHAR(), numRows, pool_.get());
+    for (int i = 0; i < numRows; ++i) {
+      std::string data("test_" + std::to_string(i));
+      auto buffer = AlignedBuffer::allocate<char>(data.length(), pool_.get());
+      auto cstr = data.c_str();
+      memcpy(buffer->asMutable<char>(), cstr, strlen(cstr));
+      c1Values->addStringBuffer(buffer);
+      c1Values->set(i, StringView(buffer->as<char>(), data.length()));
+      c0Values.push_back(i);
+    }
+
+    auto c0 = vectorMaker_.flatVector<int32_t>(c0Values);
+
+    return vectorMaker_.rowVector({c0, c1Values});
+  }
+
+  RowTypePtr rowType_;
+  std::vector<column_index_t> sortColumnIndices_;
+  std::vector<CompareFlags> sortCompareFlags_;
+  std::shared_ptr<memory::MemoryPool> pool_;
+  std::unique_ptr<OrderByRowContainer> container_;
+};
+
+// Test: Allocate a container, pin it, write rows into it, and then unpin it
+TEST_F(OrderByRowContainerTest, PinWriteUnpin) {
+  // Create test data
+  auto testData = createTestData(5);
+
+  // Add vector to container
+  auto spillableContainer = container_->addVector(testData);
+  ASSERT_NE(spillableContainer, nullptr);
+
+  // Pin the container
+  auto pinnedContainer = spillableContainer->pin();
+  ASSERT_NE(pinnedContainer, nullptr);
+
+  // Get the underlying RowContainer
+  auto rowContainer = pinnedContainer->getRowContainer();
+  ASSERT_NE(rowContainer, nullptr);
+
+  // Verify that the container has the expected number of rows
+  ASSERT_EQ(rowContainer->numRows(), 5);
+
+  // Mark the container as dirty (simulating writes)
+  pinnedContainer->markDirty();
+
+  // Verify the container is still accessible
+  ASSERT_EQ(rowContainer->numRows(), 5);
+
+  // The pinned container should be automatically unpinned when it goes out of scope
+  // at the end of this test
+}
+
+// // Test: Allocate a container, write to it, evict it, and then pin it again
+TEST_F(OrderByRowContainerTest, WriteEvictRepin) {
+  // Create test data
+  auto testData = createTestData(200);
+
+  // Add vector to container
+  auto spillableContainer = container_->addVector(testData);
+  ASSERT_NE(spillableContainer, nullptr);
+
+  // Initially pin the container to verify data
+  {
+    auto pinnedContainer = spillableContainer->pin();
+    ASSERT_NE(pinnedContainer, nullptr);
+
+    auto rowContainer = pinnedContainer->getRowContainer();
+    ASSERT_NE(rowContainer, nullptr);
+    ASSERT_EQ(rowContainer->numRows(), 200);
+
+    // Mark as dirty to simulate writes
+    pinnedContainer->markDirty();
+  } // pinnedContainer goes out of scope here (unpin)
+
+  // Force eviction by requesting more memory than available
+  // This should trigger spilling to disk
+  auto largeData = createTestData(10000); // Large enough to trigger eviction
+  auto largeContainer = container_->addVector(largeData);
+  ASSERT_NE(largeContainer, nullptr);
+
+  // Now try to pin the original container again
+  // This should load it from disk
+  auto repinnedContainer = spillableContainer->pin();
+  ASSERT_NE(repinnedContainer, nullptr);
+
+  // Verify the data is still accessible after loading from disk
+  auto rowContainer = repinnedContainer->getRowContainer();
+  ASSERT_NE(rowContainer, nullptr);
+  ASSERT_EQ(rowContainer->numRows(), 200);
+
+  // Mark as dirty again
+  repinnedContainer->markDirty();
+
+  // Clean up
+  container_->releaseContainer(largeContainer);
+}
