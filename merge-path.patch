+void ISortBuffer::reserveSpace(
+    const VectorPtr& input,
+    const RowContainer* container,
+    const common::SpillConfig* spillConfig,
+    memory::MemoryPool* const pool,
+    tsan_atomic<bool>* const nonReclaimableSection) {
+  if (spillConfig == nullptr) {
+    return;
+  }
+  auto currentMemoryUsage = pool->currentBytes();
+  auto [freeRows, outOfLineFreeBytes] = container->freeSpace();
+  const auto outOfLineBytes =
+      container->stringAllocator().retainedSize() - outOfLineFreeBytes;
+  const int64_t flatInputBytes = input->usedSize();
+  const auto minReservationBytes =
+      currentMemoryUsage * spillConfig->minSpillableReservationPct / 100;
+  const auto availableReservationBytes = pool->availableReservation();
+  const int64_t estimatedIncrementalBytes = container->sizeIncrement(
+      input->size(), outOfLineBytes ? flatInputBytes : 0);
+  bool needReserve = true;
+  if (availableReservationBytes > minReservationBytes) {
+    // If we have enough free rows for input rows and enough variable length
+    // free space for the vector's flat size, no need for spilling.
+    if (std::cmp_greater(freeRows, input->size()) &&
+        (outOfLineBytes == 0 || outOfLineFreeBytes >= flatInputBytes)) {
+      needReserve = false;
+    }
+
+    // If the current available reservation in memory pool is 2X the
+    // estimatedIncrementalBytes, no need to spill.
+    if (availableReservationBytes > 2 * estimatedIncrementalBytes) {
+      needReserve = false;
+    }
+  }
+
+  if (!needReserve) {
+    return;
+  }
+  // Try reserving targetIncrementBytes more in memory pool, if succeed, no
+  // need to spill.
+  const auto targetIncrementBytes = std::max<int64_t>(
+      estimatedIncrementalBytes * 2,
+      currentMemoryUsage * spillConfig->spillableReservationGrowthPct / 100);
+  {
+    ReclaimableSectionGuard guard(nonReclaimableSection);
+    if (pool->maybeReserve(targetIncrementBytes)) {
+      return;
+    }
+  }
+  LOG(WARNING) << "Failed to reserve " << succinctBytes(targetIncrementBytes)
+               << " for memory pool " << pool->name()
+               << ", usage: " << succinctBytes(pool->currentBytes())
+               << ", reservation: " << succinctBytes(pool->reservedBytes());
+}
+
+bool ISortBuffer::willInputFit(
+    uint64_t numRows,
