+namespace facebook::velox::exec {
+using facebook::velox::memory::MemoryPool;
+
+std::tuple<std::unique_ptr<std::ofstream>, std::unique_ptr<OutputStream>> SpilledBlockFile::createOutputStream() {
+  auto outfile = std::make_unique<std::ofstream>(filePath_);
+  auto outputStream = std::make_unique<OStreamOutputStream>(outfile.get());
+  return std::make_tuple(std::move(outfile), std::move(outputStream));
+}
+
+std::unique_ptr<ByteInputStream> SpilledBlockFile::createInputStream() {
+  auto readFile = std::make_unique<LocalReadFile>(filePath_);
+  constexpr uint64_t bufferSize = 64 * 1024 * 1024; // 64 MiB
+  auto stream = std::make_unique<facebook::velox::common::FileInputStream>(std::move(readFile), bufferSize, pool_);
+  return stream;
+}
+
+PinnedRowContainer::PinnedRowContainer(
+    std::shared_ptr<RowContainer> rows,
+    SpillableRowContainer* container)
+    : rows_(std::move(rows)), container_(container), dirty_(false) {}
+
+PinnedRowContainer::~PinnedRowContainer() {
+  container_->parent_->addToLRU(container_->parent_->containers_[container_->id_]);
+}
+
+// returns - (sortedColumnTypes, nonSortedColumnTypes, sortedSpillRowType,
+// projectionMapping)
+//
+// sortedColumnTypes - The types of the columns that are sorted (in order)
+// nonSortedColumnTypes - The types of the columns that are not sorted (in
+// order) sortedSpillRowType - The row type of the spilled rows.
+// projectionMapping - The mapping of the columns in the spilled rows to the
+// columns in the input row.
+//                     The index in this vector represents the column index in
+//                     the spilled row. The value in this vector represents the
+//                     column index in the input row. e.g. projectionMapping[0]
+//                     represents the column in the spilled row at index 0 is
+//                     the column in the input row at index
+//                     projectionMapping[0].
+std::tuple<
+    std::vector<TypePtr>,
+    std::vector<TypePtr>,
+    RowTypePtr,
+    std::vector<size_t>>
+calculateTypes(
+    const std::vector<column_index_t>& sortColumnIndices,
+    const std::vector<CompareFlags>& sortCompareFlags,
+    const RowTypePtr& inputType) {
+  std::vector<TypePtr> sortedColumnTypes;
+  std::vector<TypePtr> nonSortedColumnTypes;
+  std::vector<std::string> sortedSpillColumnNames;
+  std::vector<TypePtr> sortedSpillColumnTypes;
+  std::vector<size_t> projectionMapping;
+  sortedColumnTypes.reserve(sortColumnIndices.size());
+  nonSortedColumnTypes.reserve(inputType->size() - sortColumnIndices.size());
+  sortedSpillColumnNames.reserve(inputType->size());
+  sortedSpillColumnTypes.reserve(inputType->size());
+  std::unordered_set<column_index_t> sortedChannelSet;
+  // Sorted key columns.
+  for (column_index_t i = 0; i < sortColumnIndices.size(); ++i) {
+    projectionMapping.push_back(sortColumnIndices.at(i));
+    sortedColumnTypes.emplace_back(inputType->childAt(sortColumnIndices.at(i)));
+    sortedSpillColumnTypes.emplace_back(
+        inputType->childAt(sortColumnIndices.at(i)));
+    sortedSpillColumnNames.emplace_back(
+        inputType->nameOf(sortColumnIndices.at(i)));
+    sortedChannelSet.emplace(sortColumnIndices.at(i));
+  }
+  // Non-sorted key columns.
+  for (column_index_t i = 0, nonSortedIndex = sortCompareFlags.size();
+       i < inputType->size();
+       ++i) {
+    if (sortedChannelSet.count(i) != 0) {
+      continue;
+    }
+    projectionMapping.push_back(nonSortedIndex++);
+    nonSortedColumnTypes.emplace_back(inputType->childAt(i));
+    sortedSpillColumnTypes.emplace_back(inputType->childAt(i));
+    sortedSpillColumnNames.emplace_back(inputType->nameOf(i));
+       }
+  return std::make_tuple(
+      sortedColumnTypes,
+      nonSortedColumnTypes,
+      std::make_shared<RowType>(std::move(sortedSpillColumnNames), std::move(sortedSpillColumnTypes)),
+      projectionMapping);
+}
+
+OrderByRowContainer::OrderByRowContainer(
+    const std::vector<column_index_t>& sortColumnIndices,
+    const std::vector<CompareFlags>& sortCompareFlags,
+    const RowTypePtr& inputType,
+    std::shared_ptr<MemoryPool> pool,
+    uint64_t maxMemory)
+    : pool_(std::move(pool)),
+      maxMemory_(maxMemory),
+      head_({}),
+      tail_({}) {
+  auto
+      [sortedColumnTypes,
+       nonSortedColumnTypes,
+       sortedSpillRowType,
+       projectionMapping] =
+          calculateTypes(sortColumnIndices, sortCompareFlags, inputType);
+  sortedColumnTypes_ = sortedColumnTypes;
+  nonSortedColumnTypes_ = nonSortedColumnTypes;
+  spillType_ = sortedSpillRowType;
+  projectionMapping_ = projectionMapping;
+}
+
+OrderByRowContainer::~OrderByRowContainer() {
+  // for (auto& [id, container] : containers_) {
+  //   if (container->rows_.has_value()) {
+  //     container->rows_.value()->clear();
+  //   }
+  // }
+}
+
+std::shared_ptr<SpillableRowContainer> OrderByRowContainer::addVector(
+    const RowVectorPtr& input) {
+  uint32_t id = idCounter_.fetch_add(1);
+  auto container = std::make_shared<SpillableRowContainer>(id, this);
+  auto pinned = container->pin();
+  auto rowContainer = pinned->getRowContainer();
+
+  // Copy data from RowVector to RowContainer
+  SelectivityVector allRows(input->size());
+  std::vector<char*> rows(input->size());
+  for (int row = 0; row < input->size(); ++row) {
+    rows[row] = rowContainer->newRow();
+  }
+  auto* inputRow = input->as<RowVector>();
+  for (int i = 0; i < projectionMapping_.size(); ++i) {
+    auto outputChannel = i;
+    auto inputChannel = projectionMapping_[i];
+    DecodedVector decoded(*inputRow->childAt(inputChannel), allRows);
+    auto kind = inputRow->childAt(inputChannel)->type()->kind();
+    VELOX_DYNAMIC_TYPE_DISPATCH(
+        rowContainer->storeColumn,
+        kind,
+        decoded,
+        input->size(),
+        rows,
+        static_cast<size_t>(outputChannel));
+  }
+
+  {
+    std::lock_guard guard(lock_);
+    containers_[container->id_] = container;
+    memoryCounter_.fetch_add(
+        pinned->getRowContainer()->estimateRowSize().value_or(0));
+    addToLRU(container);
+  }
+  checkMemoryUsage();
+  return container;
+}
+
+std::shared_ptr<SpillableRowContainer> OrderByRowContainer::addRowContainer(
+    std::unique_ptr<RowContainer> rows) {
+  uint32_t id = idCounter_.fetch_add(1);
+  auto container = std::make_shared<SpillableRowContainer>(id, this);
+  container->rows_ = std::unique_ptr<RowContainer>(std::move(rows));
+  {
+    std::lock_guard lock(lock_);
+    containers_[container->id_] = container;
+    memoryCounter_.fetch_add(
+        container->rows_.value()->estimateRowSize().value_or(0));
+  }
+  addToLRU(container);
+  checkMemoryUsage();
+  return container;
+}
+
+// Removes a container from tracking. Removes from the LRU list. de-allocates
+// any in-memory row container decrements memory counter.
+void OrderByRowContainer::releaseContainer(
+    const std::shared_ptr<SpillableRowContainer>& container) {
+  std::lock_guard lock(lock_);
+
+  auto it = containers_.find(container->id_);
+  if (it != containers_.end()) {
+    auto rowContainer = it->second;
+    removeFromLRU(rowContainer);
+    if (container->rows_.has_value()) {
+      memoryCounter_.fetch_sub(
+          container->rows_.value()->estimateRowSize().value_or(0));
+    }
+    container->rows_ = {};
+    containers_.erase(it);
+  }
+}
+
+// requires that the lock must already be held. Decrements the memory counter
+// by the size of all containers removed.
+uint64_t OrderByRowContainer::reclaimMemory(uint64_t requiredBytes) {
+  uint64_t reclaimed = 0;
+  auto current = tail_;
+
+  while (reclaimed < requiredBytes) {
+    if (auto ptr = current.lock()) {
+      removeFromLRU(ptr);
+      if (ptr->rows_.has_value()) {
+        auto reclaimedMem =
+            ptr->rows_.value()->estimateRowSize().value_or(0);
+        ptr->spillToDisk();
+        ptr->rows_ = {};
+        memoryCounter_.fetch_sub(reclaimedMem);
+        reclaimed += reclaimedMem;
+      }
+      current = ptr->lruPrev_;
+      if (current.expired()) {
+        break;
+      }
+    } else {
+      break;
+    }
+  }
+
+  return reclaimed;
+}
+
+void OrderByRowContainer::addToLRU(
+    const std::shared_ptr<SpillableRowContainer>& container) {
+  if (head_.expired()) {
+    head_ = tail_ = container;
+  } else {
+    container->lruNext_ = head_;
+    if (auto head = head_.lock()) {
+      head->lruPrev_ = container;
+    }
+    head_ = container;
+  }
+}
+
+void OrderByRowContainer::removeFromLRU(
+    const std::shared_ptr<SpillableRowContainer>& container) {
+  if (auto head = head_.lock()) {
+    if (container == head) {
+      head_ = container->lruNext_;
+    }
+  }
+  if (auto tail = tail_.lock()) {
+    if (container == tail) {
+      tail_ = container->lruPrev_;
+    }
+  }
+
+  if (auto prev = container->lruPrev_.lock()) {
+    prev->lruNext_ = container->lruNext_;
+  }
+  if (auto next = container->lruNext_.lock()) {
+    next->lruPrev_ = container->lruPrev_;
+  }
+
+  container->lruPrev_ = {};
+  container->lruNext_ = {};
+}
+
+void OrderByRowContainer::checkMemoryUsage() {
+  std::lock_guard lock(lock_);
+  uint64_t usedMemory = memoryCounter_.load();
+  if (usedMemory > maxMemory_) {
+    reclaimMemory(usedMemory - maxMemory_);
+  }
+}
+
+SpillableRowContainer::SpillableRowContainer(uint32_t id, OrderByRowContainer* parent) : id_(id), parent_(parent) {
+  spillMemoryPool_ = parent_->pool_;
+  spillRowType_ = parent_->spillType_;
+}
+
+std::shared_ptr<PinnedRowContainer> SpillableRowContainer::pin() {
+  std::lock_guard lock(lock_);
+  // if the rows already exists, remove it from the LRU list and return the
+  // pinned reference
+  if (rows_.has_value()) {
+    parent_->removeFromLRU(parent_->containers_[id_]);
+  } else {
+    // previously evicted, load from disk
+    loadFromDisk();
+  }
+
+  return std::make_shared<PinnedRowContainer>(rows_.value(), this);
+}
+
+std::vector<char*> getAllRows(const std::shared_ptr<RowContainer>& container) {
+  // Get total number of rows first
+  int64_t totalRows = container->numRows();
+
+  // Prepare vector to hold all row pointers
+  std::vector<char*> allRows(totalRows);
+
+  // Create iterator and reset it to start from beginning
+  RowContainerIterator iter;
+  iter.reset();
+
+  // Get all rows in one call
+  int32_t rowsRetrieved = container->listRows(&iter, totalRows, allRows.data());
+
+  // Resize vector if fewer rows were returned (shouldn't happen with totalRows)
+  allRows.resize(rowsRetrieved);
+
+  return allRows;
+}
+
+
+std::string SpillableRowContainer::filePath() const {
+  return "/tmp/orderby_spill_" + std::to_string(id_);
+}
+
+void SpillableRowContainer::spillToDisk() {
+  std::lock_guard lock(lock_);
+
+  if (!rows_.has_value()) {
+    return; // no data to spill
+  }
+
+  // collect the data to spill first. We need to know the size of the write.
+  auto rowContainer = rows_.value();
+  auto allRows = getAllRows(rowContainer);
+  // Extract serialized rows.
+  auto serialized = BaseVector::create<FlatVector<StringView>>(
+      VARBINARY(), allRows.size(), spillMemoryPool_.get());
+  rowContainer->extractSerializedRows(
+      folly::Range<char**>(allRows.data(), allRows.size()), serialized);
+  auto serde = serializer::spark::UnsafeRowVectorSerde();
+  auto serializer = serde.createBatchSerializer(spillMemoryPool_.get());
+  spillFile_ = SpilledBlockFile(filePath(), spillMemoryPool_.get());
+  auto [outfile, outputStream] = spillFile_.value().createOutputStream();
+  auto rowVector = std::shared_ptr<RowVector>(new RowVector(
+      spillMemoryPool_.get(),
+      ROW({"data"}, {VARBINARY()}),
+      BufferPtr(nullptr),
+      serialized->size(),
+      {serialized}));
+  serializer->serialize(rowVector, outputStream.get());
+
+  // Clear the in-memory data
+  rows_.reset();
+}
+
+
+// Load a block from disk. rows_ is guaranteed to be populated after this method
+// is called. It is not added to the parent LRU list yet though.
+void SpillableRowContainer::loadFromDisk() {
+  std::lock_guard lock(lock_);
+
+  if (!spillFile_.has_value() || rows_.has_value()) {
+    if (!rows_.has_value()) {
+      // rows_ must be populated. In this case, it's likely that the container
+      // was never written to before. Create a new row container.
+      rows_ = std::make_shared<RowContainer>(parent_->sortedColumnTypes_, parent_->nonSortedColumnTypes_, spillMemoryPool_.get());
+    }
+    return; // Not spilled or already loaded
+  }
+
+  // Read from spillFile, deserialize rows
+  auto inputStream = spillFile_.value().createInputStream();
+  auto serde = serializer::spark::UnsafeRowVectorSerde();
+  RowTypePtr type = ROW({"data"}, {VARBINARY()});
+  RowVectorPtr result = RowVector::createEmpty(std::move(type), spillMemoryPool_.get());
+  serde.deserialize(
+    inputStream.get(),
+    spillMemoryPool_.get(),
+    std::move(type),
+    &result,
+    nullptr);
+  rows_ = std::make_shared<RowContainer>(parent_->sortedColumnTypes_, parent_->nonSortedColumnTypes_, spillMemoryPool_.get());
+  auto serializedRows = result->childAt(0)->asFlatVector<StringView>();
+
+  for (auto i = 0; i < result->size(); ++i) {
+    char* row = rows_.value()->newRow();
+    rows_.value()->storeSerializedRow(*serializedRows, i, row);
+  }
+}
+
+} // namespace facebook::velox::exec
