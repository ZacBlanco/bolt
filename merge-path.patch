+OrderedContainer::OrderedContainer(
+    uint64_t totalRecords,
+    std::vector<std::shared_ptr<SpillableRowContainer>>&& containers,
+    std::vector<ContainerBounds>&& partitions,
+    std::vector<uint64_t>&& indexes,
+    std::shared_ptr<RowContainer>&& partitionBoundsRowContainer_)
+    : sortedContainers_(std::move(containers)),
+      partitions_(std::move(partitions)),
+      indexes_(std::move(indexes)),
+      partitionBoundsRowContainer_(std::move(partitionBoundsRowContainer_)),
+      totalRecords_(totalRecords) {}
