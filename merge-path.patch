+std::pair<uint64_t, uint64_t> OrderedContainer::getContainerIdx(
+    uint64_t idx,
+    const std::vector<uint64_t>& indexes) {
+  uint64_t low_idx = 0;
+  uint64_t max_idx = indexes.size() - 1;
+  while (true) {
+    uint64_t mid_idx = low_idx + ((max_idx - low_idx) / 2);
+    if (idx >= indexes[mid_idx]) {
+      if ((mid_idx + 1 < indexes.size() && idx < indexes[mid_idx + 1]) ||
+          mid_idx + 1 == indexes.size()) {
+        return std::pair(mid_idx, idx - indexes[mid_idx]);
+      }
+      low_idx = mid_idx + 1;
+    } else {
+      max_idx = mid_idx - 1;
+    }
+    if (max_idx == low_idx) {
+      return std::pair(max_idx, idx - indexes[max_idx]);
+    }
+  }
+}
+std::pair<uint64_t, uint64_t> OrderedContainer::getContainerIdx(
+    uint64_t idx) const {
+  return getContainerIdx(idx, indexes_);
+}
