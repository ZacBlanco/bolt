+class OrderByBenchmark : public HiveConnectorTestBase {
+ public:
+  static void SetUpTestCase() {
+    OperatorTestBase::SetUpTestCase();
+  }
+
+  static void TearDownTestCase() {
+    OperatorTestBase::TearDownTestCase();
+  }
+
+  explicit OrderByBenchmark(const OrderByBenchmarkParam& param) {
+    HiveConnectorTestBase::SetUp();
+    inputType_ = getTableSchema(Table::TBL_LINEITEM, false);
+
+    // check if path at inputDataPath exists in the filesystem
+    if (!std::filesystem::exists(param.inputDataPath)) {
+      // Generate TPC-H lineitem data and write to a file
+      generateTpchLineItemData(param.inputDataPath, param.tpchScaleFactor);
+      std::cout << "Generated TPC-H lineitem data at: " << param.inputDataPath
+                << std::endl;
+    } else {
+      std::cout << "Using existing TPC-H lineitem data at: "
+                << param.inputDataPath << std::endl;
+    }
+  }
+
+  ~OrderByBenchmark() override {
+    HiveConnectorTestBase::TearDown();
+  }
+
+  void TestBody() override {}
+
+  void generateTpchLineItemData(const std::string& path, double scaleFactor) {
+    // Generate TPCH lineitem data with the specified scale factor
+    std::cout << "Generating TPCH lineitem data with scale factor "
+              << scaleFactor << "..." << std::endl;
+    constexpr size_t kBatchSize = 100000;
+    size_t totalRows = getRowCount(Table::TBL_LINEITEM, scaleFactor);
+    std::cout << "Total rows to generate: " << totalRows << std::endl;
+
+    std::vector<RowVectorPtr> vectors;
+    size_t offset = 0;
+    size_t remainingRows = totalRows;
+
+    // Generate data in batches
+    while (remainingRows > 0) {
+      size_t currentBatchSize = std::min(kBatchSize, remainingRows);
+      auto batch =
+          genTpchLineItem(pool(), currentBatchSize, offset, scaleFactor, false);
+      vectors.push_back(batch);
+      offset += currentBatchSize;
+      remainingRows -= currentBatchSize;
+    }
+
+    std::cout << "Generated " << vectors.size()
+              << " batches. Writing to file..." << std::endl;
+
+    // Create config with no compression
+    auto config = std::make_shared<dwrf::Config>();
+    config->set(
+        dwrf::Config::COMPRESSION,
+        common::CompressionKind::CompressionKind_NONE);
+
+    writeToFile(path, vectors, config);
+    std::cout << "Data generation complete." << std::endl;
+  }
+
+  OrderByBenchmarkResult run(const OrderByBenchmarkParam& param) {
+    folly::BenchmarkSuspender suspender;
+
+    // Prepare scan columns (all columns needed for sort keys and other columns)
+    std::vector<std::string> scanNames;
+    std::vector<TypePtr> scanTypes;
+    for (const auto& [key, _] : param.sortKeys) {
+      if (std::find(scanNames.begin(), scanNames.end(), key) ==
+          scanNames.end()) {
+        scanNames.push_back(key);
+        scanTypes.push_back(inputType_->findChild(key));
+      }
+    }
+    for (const auto& name : param.otherColumns) {
+      if (std::find(scanNames.begin(), scanNames.end(), name) ==
+          scanNames.end()) {
+        scanNames.push_back(name);
+        scanTypes.push_back(inputType_->findChild(name));
+      }
+    }
+
+    // Create plan with TableScan followed by OrderBy
+    auto planBuilder = PlanBuilder().tableScan(
+        ROW(std::move(scanNames), std::move(scanTypes)));
+
+    // Add OrderBy operator with the specified sort keys
+    std::vector<std::string> orderByKeys;
+    std::vector<bool> orders;
+    for (const auto& [key, ascending] : param.sortKeys) {
+      orderByKeys.push_back(key);
+      orders.push_back(ascending);
+    }
+    auto plan = planBuilder.orderBy(orderByKeys, false).planFragment();
+
+    // Create task with the specified configuration
+    auto task = makeTask(plan, param);
+
+    // Run the benchmark
+    suspender.dismiss();
+    while (auto result = task->next()) {
+      // Optionally buffer to disk or discard from memory
+      // For benchmark purposes, we're just counting rows
+      folly::doNotOptimizeAway(result->size());
+    }
+
+    // Collect statistics
+    OrderByBenchmarkResult result;
+    facebook::velox::exec::OperatorStats orderByStats;
+    for (auto pipelineStat : task->taskStats().pipelineStats) {
+      for (auto operatorStat : pipelineStat.operatorStats) {
+        if (operatorStat.operatorType == "OrderBy") {
+          orderByStats = operatorStat;
+        }
+      }
+    }
+    CpuWallTiming timing;
+    timing.add(orderByStats.addInputTiming);
+    timing.add(orderByStats.getOutputTiming);
+    timing.add(orderByStats.finishTiming);
+    result.totalOrderByTimeMs = timing.wallNanos / 1000'000.0;
+    result.spillRow = orderByStats.spilledRows;
+    result.spillBytes = orderByStats.spilledBytes;
+    result.spillSortTimeMs =
+        orderByStats.runtimeStats["spillSortTime"].sum / 1000'000.0;
+    result.spillFillTimeMs =
+        orderByStats.runtimeStats["spillFillTime"].sum / 1000'000.0;
+    result.spillConvertTimeMs =
+        orderByStats.runtimeStats["spillConvertTime"].sum / 1000'000.0;
+    result.spillSerializeTimeMs =
+        orderByStats.runtimeStats["spillSerializationTime"].sum / 1000'000.0;
+    result.spillFlushTimeMs =
+        orderByStats.runtimeStats["spillFlushTime"].sum / 1000'000.0;
+    result.spillWrites =
+        orderByStats.runtimeStats[exec::Operator::kSpillWrites].sum;
+    result.spillWriteTimeMs =
+        orderByStats.runtimeStats["spillWriteTime"].sum / 1000'000.0;
+    result.spillReadTimeMs =
+        orderByStats.runtimeStats["spillReadTotalTime"].sum / 1000'000.0;
+
+    return result;
+  }
+
+  std::shared_ptr<exec::Task> makeTask(
+      core::PlanFragment plan,
+      const OrderByBenchmarkParam& param) {
+    auto queryCtx = std::make_shared<core::QueryCtx>(executor_.get());
+    std::unordered_map<std::string, std::string> configs;
+
+    // Configure merge path
+    if (param.enableMergePath) {
+      configs[core::QueryConfig::kOrderByMergePathEnabled] = "true";
+      configs[core::QueryConfig::kOrderByMergePathParallelism] =
+          std::to_string(param.mergePathParallelism);
+      configs[core::QueryConfig::kOrderByMergePathParallelTargetRows] =
+          std::to_string(param.mergePathParallelTargetRows);
+    }
+
+    // Configure spill
+    if (param.enableSortSpill) {
+      configs[core::QueryConfig::kSpillEnabled] = "true";
+      configs[core::QueryConfig::kOrderBySpillEnabled] = "true";
+      configs[core::QueryConfig::kOrderBySpillMemoryThreshold] =
+          std::to_string(param.spillMemoryThreshold);
+      if (!param.rowBasedSpillMode.empty()) {
+        configs[core::QueryConfig::kRowBasedSpillMode] =
+            param.rowBasedSpillMode;
+      }
+    }
+
+    queryCtx->testingOverrideConfigUnsafe(std::move(configs));
+    auto task =
+        exec::Task::create("orderByBenchmark", std::move(plan), 0, queryCtx);
+    task->setSpillDirectory("/tmp/" + task->uuid(), false);
+    task->addSplit(
+        "0",
+        exec::Split(makeHiveConnectorSplit("file:" + param.inputDataPath)));
+    task->noMoreSplits("0");
+    return task;
+  }
+
+ private:
+  RowTypePtr inputType_;
+};
+
+std::vector<std::pair<std::string, bool>> parseSortKeys(
+    const std::string& sortKeysStr) {
+  std::vector<std::pair<std::string, bool>> sortKeys;
+
+  if (sortKeysStr.empty()) {
+    return sortKeys;
+  }
+
+  std::vector<std::string> parts;
+  std::stringstream ss(sortKeysStr);
+  std::string part;
+
+  // Split the string by commas
+  while (std::getline(ss, part, ',')) {
+    if (!part.empty()) {
+      parts.push_back(part);
+    }
+  }
+
+  // Process pairs of column name and direction
+  for (size_t i = 0; i < parts.size(); i += 2) {
+    std::string column = parts[i];
+    std::string direction = "asc"; // Default to ascending
+
+    // Check if there's a direction specified
+    if (i + 1 < parts.size()) {
+      direction = parts[i + 1];
+    }
+
+    bool ascending = (direction == "asc") || (direction == "ASC");
+    sortKeys.emplace_back(column, ascending);
+  }
+
+  return sortKeys;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+  folly::init(&argc, &argv);
+  OrderByBenchmark::SetUpTestCase();
+  // memory::MemoryManagerOptions options = {};
+  // options.allocatorCapacity = 64L * (1L << 30);
+  // memory::MemoryManager::initialize(options);
+  std::vector<OrderByBenchmarkParam> params;
+  std::vector<OrderByBenchmarkResult> results;
+
+  // Parse sort keys from command line flag
+  auto sortKeys = parseSortKeys(FLAGS_sort_keys);
+  if (sortKeys.empty()) {
+    // Default to sorting by l_orderkey in ascending order if no sort keys are
+    // provided
+    sortKeys.emplace_back("orderkey", true);
+  }
+
+  std::vector<std::string> otherColumns;
+  std::stringstream ss(FLAGS_other_columns);
+  std::string column;
+  while (std::getline(ss, column, ',')) {
+    if (!column.empty()) {
+      otherColumns.push_back(column);
+    }
+  }
+
+  // Create benchmark parameter with all flag values
+  OrderByBenchmarkParam param(
+      sortKeys,
+      otherColumns,
+      FLAGS_input_file_path,
+      FLAGS_enable_sort_spill,
+      FLAGS_row_based_spill_mode,
+      FLAGS_enable_merge_path,
+      FLAGS_tpch_scale_factor,
+      FLAGS_spill_memory_threshold,
+      FLAGS_merge_path_parallelism,
+      FLAGS_merge_path_parallel_target_rows);
+
+  params.push_back(param);
+
+  // Create benchmark instance with the parameter
+  std::unique_ptr<OrderByBenchmark> benchmark =
+      std::make_unique<OrderByBenchmark>(param);
+
+  // Run the benchmark
+  for (auto& param : params) {
+    folly::addBenchmark(
+        __FILE__, param.caseName(), [param, &benchmark, &results]() {
+          results.push_back(benchmark->run(param));
+          return 1;
+        });
+  }
+
+  folly::runBenchmarks();
+  benchmark.reset();
+
+  // Print results
+  std::cout << OrderByBenchmarkResult::title() << std::endl;
+  for (auto result : results) {
+    std::cout << result.toString() << std::endl;
+  }
+
+  OrderByBenchmark::TearDownTestCase();
+  return 0;
+}
