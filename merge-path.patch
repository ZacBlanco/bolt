-void OrderByMergePath::noMoreInput() {
-  // Parallel Sorting Algorithm
-  // Set up:
-    // assume all of our spilled containers are pre-sorted, create a stack of work
-  std::stack<std::shared_ptr<OrderedContainer>> ordered_containers;
-  for (const auto & container : containers_) {
-    ordered_containers.push(OrderedContainer::newContainer(container));
-  }
-  // the original container are no longer required. Clear the vec to allow releasing memory later
-  containers_.clear();
-  // now we have a stack of ordered vectors.
-  // we merge them by combining two containers together until we only have a single sorted container
-  while (ordered_containers.size() > 1) {
-    // gather all pairs of vectors, combine, and then push back to the stack.
