+    for (int i = 0; i < result->size() - 1; ++i) {
+      int32_t val1_c1 = resultCol1->valueAt(i);
+      int32_t val2_c1 = resultCol1->valueAt(i + 1);
+      auto val1_c5 = resultCol5->valueAt(i);
+      auto val2_c5 = resultCol5->valueAt(i + 1);
