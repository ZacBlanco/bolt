+        mergePathParallelism(mergePathParallelism_),
+        mergePathParallelTargetRows(mergePathParallelTargetRows_) {}
+
+  std::string caseName() const {
+    // Convert sort keys to a string representation
+    std::string sortKeysStr;
+    for (size_t i = 0; i < sortKeys.size(); ++i) {
+      if (i > 0) {
+        sortKeysStr += ",";
+      }
+      sortKeysStr +=
+          sortKeys[i].first + ":" + (sortKeys[i].second ? "asc" : "desc");
+    }
+
+    return fmt::format(
+        "orderby_scale_{}_mergepath_{}_parallelism_{}_spill_{}_sortkeys_{}",
+        tpchScaleFactor,
+        (enableMergePath ? "on" : "off"),
