+SortBufferMergePath::SortBufferMergePath(
+    const RowTypePtr& input,
+    const std::vector<column_index_t>& sortColumnIndices,
+    const std::vector<CompareFlags>& sortCompareFlags,
+    MemoryPool* pool,
+    const core::QueryConfig* queryConfig,
+    // the rest of these parameters may be null
+    const common::SpillConfig* spillConfig,
+    folly::Executor* mergeExecutor,
+    folly::Executor* combineExecutor)
+: parallelism_(queryConfig->orderByMergePathParallelism() == 0
+                    ? std::thread::hardware_concurrency()
+                    : queryConfig->orderByMergePathParallelism()),
+inputVectors_(parallelism_),
+inputVectorMemoryLimit_(queryConfig->orderBySpillMemoryThreshold() != 0 ? queryConfig->orderBySpillMemoryThreshold() / parallelism_ : 256L << 20),
+mergeExecutor_(
+          mergeExecutor
+              ? mergeExecutor
+              : new folly::CPUThreadPoolExecutor(parallelism_)),
+      combineExecutor_(
+          combineExecutor
+              ? combineExecutor
+              : new folly::CPUThreadPoolExecutor(parallelism_)) {
+  // minimum target memory is 1MB regardless of what user sets. Otherwise,
+  // if spilling is allowed, divide the spill memory threshold by 128 for higher
+  // parallelism. If it's not set, use a container target size of 128MB
+  targetContainerMemory_ = std::max(
+      1UL << 20,
+      queryConfig->orderBySpillMemoryThreshold() == 0
+          ? 128UL << 20
+          : queryConfig->orderBySpillMemoryThreshold() / 128);
+  targetParallelRows_ = queryConfig->orderByMergePathParallelTargetRows();
+  sortCompareFlags_ = sortCompareFlags;
+  pool_ = pool;
+  sorter_ = HybridSorter();
+  VELOX_CHECK(pool_->trackUsage());
+  rowContainer_ = std::make_unique<OrderByRowContainer>(
+      sortColumnIndices,
+      sortCompareFlags,
+      input,
+      pool_,
+      spillConfig,
+      queryConfig->orderBySpillMemoryThreshold());
+}
