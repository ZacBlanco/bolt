+  const std::vector<column_index_t>& sortColumnIndices,
+  const std::vector<CompareFlags>& sortCompareFlags,
+velox::memory::MemoryPool* pool,
+tsan_atomic<bool>* nonReclaimableSection,
+const common::SpillConfig* spillConfig,
+uint64_t spillMemoryThreshold,
+OperatorCtx* operatorCtx) {
+  maxOutputRows_ = 10000; // TODO properly get from operatorCtx
+  sortCompareFlags_ = sortCompareFlags;
+  pool_ = pool;
+  sorter_ = HybridSorter();
+  VELOX_CHECK(pool_->trackUsage());
+  rowContainer_ = std::make_unique<OrderByRowContainer>(sortColumnIndices, sortCompareFlags, input, pool_, spillMemoryThreshold);
+
+  // this->setRuntimeMetric(
+  //     OperatorMetricKey::kCanUsedToEstimateHashBuildPartitionNum, "true");
+  // this->setRuntimeMetric(
+  //     OperatorMetricKey::kTotalRowCount, folly::to<std::string>(0));
+  // this->setRuntimeMetric(
+  //     OperatorMetricKey::kHasBeenProcessedRowCount, folly::to<std::string>(0));
+  // LOG(INFO) << name() << " construct, output type: " << outputType_->toString();
+}
+
+
+void sortPinned(std::shared_ptr<PinnedRowContainer>& pinned, HybridSorter& sorter, const std::vector<CompareFlags>& sortCompareFlags) {
+  auto container = pinned->getRowContainer();
+  auto& rows = pinned->getRows();
+  sorter.template sort(
+        rows.begin(),
+        rows.end(),
+        [container, sortCompareFlags](const char* leftRow, const char* rightRow) {
+          for (vector_size_t index = 0; index < sortCompareFlags.size();
+               ++index) {
+            if (auto result = container->compare(
+                    leftRow, rightRow, index, sortCompareFlags[index])) {
+              return result < 0;
+            }
+          }
+          return false;
+        });
+}
+
+void OrderByMergePath::addInput(RowVectorPtr input) {
+  auto container = rowContainer_->addVector(input);
+  auto pinned = container->pin();
+  sortPinned(pinned, sorter_, sortCompareFlags_);
+  containers_.push_back(container);
+}
+
+
+void OrderByMergePath::reclaim(
+    uint64_t targetBytes,
+    memory::MemoryReclaimer::Stats& stats) {
+  rowContainer_->reclaimMemory(targetBytes);
+}
+
+struct ArrayPartition {
+  uint64_t min_idx; // inclusive
+  uint64_t max_idx; // exclusive
+};
+
+struct ContainerBounds {
+  char* min_row_;
+  char* max_row_;
+};
+
+class OrderedContainer {
+public:
+  OrderedContainer(
+    std::vector<std::shared_ptr<SpillableRowContainer>>&& containers,
+    std::vector<ContainerBounds>&& partitions,
+    std::vector<uint64_t>&& indexes,
+    std::shared_ptr<RowContainer>&& partition_bounds_row_container,
+    uint64_t total_records) {
+    sorted_containers_ = std::move(containers);
+    partitions_ = std::move(partitions);
+    indexes_ = std::move(indexes);
+    partition_bounds_row_container_ = std::move(partition_bounds_row_container);
+    total_records_ = total_records;
+  }
+  // this vector should maintain the following invariant:
+  // max(sorted_containers_[i]) <= min(sorted_containers_[i + 1])
+  std::vector<std::shared_ptr<SpillableRowContainer>> sorted_containers_;
+  // This should always have the same number of values as the sorted_containers_ vector
+  std::vector<ContainerBounds> partitions_;
+  // represents the absolute index of the first record in the sorted_containers_ vector
+  std::vector<uint64_t> indexes_;
+  std::shared_ptr<RowContainer> partition_bounds_row_container_;
+  std::uint64_t total_records_{0};
+
+  // returns a pair of indexes representing (1) The index of the sorted container in the
+  // internal sorted_containers_ list. And (2) The index within the container itself.
+  std::pair<uint32_t, uint32_t> get_container_idx(uint32_t idx) {
+    uint32_t low_idx = 0;
+    uint32_t max_idx = indexes_.size() - 1;
+    while (true) {
+      uint32_t mid_idx = (max_idx - low_idx) / 2;
+      if (idx >= indexes_[mid_idx] && idx < indexes_.size() && idx < indexes_[mid_idx + 1]) {
+        return std::pair(mid_idx, idx - indexes_[mid_idx]);
+      } else if (idx < indexes_[mid_idx]) {
+        max_idx = mid_idx;
+      } else {
+        low_idx = mid_idx;
+      }
+      if (max_idx == low_idx) {
+        return std::pair(max_idx, idx - indexes_[max_idx]);
+      }
+    }
+  }
+
+  static std::shared_ptr<OrderedContainer> newContainer(std::shared_ptr<SpillableRowContainer> container) {
+    return std::make_shared<OrderedContainer>(
+      std::vector<std::shared_ptr<SpillableRowContainer>>{std::move(container)},
+      std::vector<ContainerBounds>{},
+      std::vector<uint64_t>{0},
+      std::shared_ptr<RowContainer>(nullptr),
+      container->numRows());
+  }
+
+  static std::shared_ptr<OrderedContainer> merge(
+    std::vector<std::shared_ptr<OrderedContainer>>& containers) {
+    // compute new total_records_ for the merged container.
+    std::uint64_t new_total_records = 0;
+    for (auto& container : containers) {
+      new_total_records += container->total_records_;
+    }
+    // compute new indexes_ for the merged container.
+    // the first container maintains it's indexes array. The subsequent indexes
+    // are concatenated on to the new index array, but their values are offset
+    // by the total_records_ of the previous containers.
+    std::vector<uint64_t> new_indexes =containers[0]->indexes_;
+    uint64_t current_total_records = containers[0]->total_records_;
+    // skip first container in loop
+    for (auto& container : containers) {
+      if (container == containers[0]) {
+        continue;
+      }
+      // transform all indexes in container by adding the total_records_ of the previous container.
+      std::vector<uint64_t> tmp_indexes;
+      std::transform(container->indexes_.begin(), container->indexes_.end(), tmp_indexes.begin(), [current_total_records](uint64_t idx) { return idx + current_total_records; });
+      new_indexes.insert(new_indexes.end(), tmp_indexes.begin(), tmp_indexes.end());
+    }
+
+    // concatenate all internal containers
+    std::vector<std::shared_ptr<SpillableRowContainer>> new_sorted_containers;
+    for (auto& container : containers) {
+      new_sorted_containers.insert(new_sorted_containers.end(), container->sorted_containers_.begin(), container->sorted_containers_.end());
+    }
+    return std::make_shared<OrderedContainer>(
+      std::move(new_sorted_containers),
+      std::vector<ContainerBounds>(),
+      std::move(new_indexes),
+      std::shared_ptr<RowContainer>(nullptr),
+      new_total_records);
+  }
+};
+
+// returns -1, 0, or 1 if the row at idx is <, =, or > than other_idx inside of other
+int8_t compare(uint32_t a_idx, const std::shared_ptr<PinnedRowContainer>& a_pinned, uint32_t b_idx, const std::shared_ptr<PinnedRowContainer>& b_pinned, const OrderByMergePath*& op) {
+  // technically, compareRows is meant to compare rows in the same container, but since we know all containers
+  // have the same types, the rows can still be compared without issue since the comparison
+  // doesn't rely on any container-specific data.
+  char* row_a = a_pinned->getRows()[a_idx];
+  char* row_b = b_pinned->getRows()[b_idx];
+  return a_pinned->getRowContainer()->compareRows(row_a, row_b, op->getSortCompareFlags());
+}
+
+// Algorithm 2 of Merge Paths paper on p.7 (https://arxiv.org/pdf/1406.2628)
+// calculate the diagonal intersection of 2 ordered containers.
+// Returns a pair of <a_start, b_start>. This represents the starting index of
+// the intersection in each container.
+std::pair<uint32_t, uint32_t> DiagonalIntersection(
+  std::shared_ptr<OrderedContainer> a,
+  std::shared_ptr<OrderedContainer> b,
+  const uint32_t thread_id,
+  const uint32_t parallelization_threshold,
+  const OrderByMergePath* op) {
+  const uint32_t diag = thread_id * (a->total_records_ + b->total_records_) / parallelization_threshold;
+  uint32_t a_top;
+  uint32_t b_top;
+  uint32_t a_start;
+  uint32_t b_start;
+  if (diag > a->total_records_) {
+    a_top = a->total_records_;
+    b_top = diag - a->total_records_;
+  } else {
+    a_top = diag;
+    b_top = 0;
+  }
+  uint32_t a_bottom = b_top;
+
+  // We will only pin 2 containers at a time
+  std::shared_ptr<PinnedRowContainer> a_container;
+  std::shared_ptr<PinnedRowContainer> b_container;
+  uint32_t a_container_idx = 0;
+  uint32_t b_container_idx = 0;
+  while (true) {
+    uint32_t offset = (a_top - a_bottom) / 2;
+    uint32_t a_i = a_top - offset;
+    uint32_t b_i = b_top + offset;
+    auto [a_idx, a_compare_idx] = a->get_container_idx(a_i);
+    auto [b_idx, b_compare_idx] = b->get_container_idx(b_i - 1);
+    // pin the containers if necessary
+    if (a_container_idx != a_idx || a_container == nullptr) {
+      a_container = a->sorted_containers_[a_idx]->pin();
+      a_container_idx = a_idx;
+    }
+    if (b_container_idx != b_idx || b_container == nullptr) {
+      b_container = b->sorted_containers_[b_idx]->pin();
+      b_container_idx = b_idx;
+    }
+    // compare A[a_i] > B[b_i - 1]
+    if (compare(a_compare_idx, a_container, b_compare_idx, b_container, op) > 0) {
+      auto [a_idx, a_compare_idx] = a->get_container_idx(a_i - 1);
+      auto [b_idx, b_compare_idx] = b->get_container_idx(b_i);
+      // pin the containers if necessary
+      if (a_container_idx != a_idx || a_container == nullptr) {
+        a_container = a->sorted_containers_[a_idx]->pin();
+        a_container_idx = a_idx;
+      }
+      if (b_container_idx != b_idx || b_container == nullptr) {
+        b_container = b->sorted_containers_[b_idx]->pin();
+        b_container_idx = b_idx;
+      }
+      // compare A[a_i - 1] <= B[b_i]
+      if (compare(a_compare_idx, a_container, b_compare_idx, b_container, op) <= 0) {
+        a_start = a_i;
+        b_start = b_i;
+        break;
+      }
+      a_top = a_i - 1;
+      b_top = b_i + 1;
+    } else {
+      a_bottom = a_i + 1;
+    }
+  }
+  return {a_start, b_start};
+}
+
+class SortWork {
+public:
+  std::shared_ptr<OrderedContainer> a;
+  std::shared_ptr<OrderedContainer> b;
+  ArrayPartition a_part;
+  ArrayPartition b_part;
+  const OrderByMergePath* op;
+  SortWork(std::shared_ptr<OrderedContainer> a,
+    std::shared_ptr<OrderedContainer> b,
+    ArrayPartition a_part,
+    ArrayPartition b_part,
+    const OrderByMergePath* op)
+  : a(std::move(a)), b(std::move(b)), a_part(a_part), b_part(b_part), op(op) {}
+
+  std::shared_ptr<OrderedContainer> merge() {
+    // absolute indexes within entire sorted container
+    uint32_t a_current = a_part.min_idx;
+    uint32_t b_current = b_part.min_idx;
+    // current result container
+    std::unique_ptr<RowContainer> current_result_container = op->rowContainer_->emptyRowContainer();
+    std::vector<char*> current_result_container_rows;
+    uint64_t current_row_count = 0;
+    std::vector<std::shared_ptr<SpillableRowContainer>> results;
+    std::vector<uint64_t> indexes;
+    // *_idx is the index of the container in the sorted_containers_ vector
+    // *_compare_idx is the relative index of the element in the container which should
+    // be compared.
+    auto [a_idx, a_compare_idx] = a->get_container_idx(a_current);
+    auto [b_idx, b_compare_idx] = b->get_container_idx(b_current);
+    // pin the containers if necessary
+    auto a_container = a->sorted_containers_[a_idx]->pin();
+    auto b_container = b->sorted_containers_[b_idx]->pin();
+    std::vector<std::pair<bool, RowColumn>> variableColumns;
+    // populate variableColumns vector for row copy function.
+    for (int i = 0; i < a_container->getRowContainer()->columnTypes().size(); i++) {
+      auto type = a_container->getRowContainer()->columnTypes()[i];
+      if (!type->isFixedWidth()) {
+        bool isStringType = type->kind() == TypeKind::VARCHAR ||
+            type->kind() == TypeKind::VARBINARY;
+        variableColumns.emplace_back(isStringType, a_container->getRowContainer()->columns()[i]);
+      }
+    }
+    while (a_current < a_part.max_idx  && b_current < b_part.max_idx) {
+      // check if a new result container needs to be created.
+      if (current_result_container->numRows() >= op->maxContainerRows_) {
+        std::shared_ptr<SpillableRowContainer> result_container =
+          op->rowContainer_->addRowContainer(
+            std::move(current_result_container),
+            std::move(current_result_container_rows));
+        results.push_back(result_container);
+        indexes.push_back(current_row_count);
+        current_result_container = op->rowContainer_->emptyRowContainer();
+        current_result_container_rows.clear();
+      }
+
+      // *_compare_idx should be less than the size of the current pinned container.
+      // otherwise, pin a new container, increment a_idx and reset a_compare_idx to 0.
+      if (a_idx < a->indexes_.size() - 1 &&  a_current < a->indexes_[a_idx + 1]) {
+        a_idx++;
+        a_compare_idx = 0;
+        a_container = a->sorted_containers_[a_idx]->pin();
+      }
+      if (b_idx < b->indexes_.size() - 1 && b_current < b->indexes_[b_idx + 1]) {
+        b_idx++;
+        b_compare_idx = 0;
+        b_container = b->sorted_containers_[b_idx]->pin();
+      }
+      // compare
+      if (compare(a_compare_idx, a_container, b_compare_idx, b_container, op) <= 0) {
+        current_result_container->copySerializedRow(a_container->getRows()[a_compare_idx], a_container->getRowContainer()->fixedRowSize(), variableColumns);
+        a_current++;
+        a_compare_idx++;
+      } else {
+        current_result_container->copySerializedRow(b_container->getRows()[b_compare_idx], b_container->getRowContainer()->fixedRowSize(), variableColumns);
+        b_current++;
+        b_compare_idx++;
+      }
+    }
+    // there may be rows left in a or b. Copy the remaining rows from the current
+    // idx in the remaining vector into the final result containers.
+    uint64_t current_idx;
+    uint64_t current_container_idx;
+    uint64_t current_compare_idx;
+    uint64_t max_idx;
+    std::shared_ptr<OrderedContainer> remainingRecords;
+    std::shared_ptr<PinnedRowContainer> remainingPinned;
+    if (a_current < a_part.max_idx) {
+      current_idx = a_current;
+      current_container_idx = a_idx;
+      current_compare_idx = a_compare_idx;
+      max_idx = a_part.max_idx;
+      remainingRecords = a;
+      remainingPinned = a_container;
+    } else {
+      current_idx = b_current;
+      current_container_idx = b_idx;
+      current_compare_idx = b_compare_idx;
+      max_idx = b_part.max_idx;
+      remainingRecords = b;
+      remainingPinned = b_container;
+    }
+    while (current_idx < max_idx) {
+      // create a new result container if required
+      if (current_result_container->numRows() >= op->maxContainerRows_) {
+        std::shared_ptr<SpillableRowContainer> result_container = op->rowContainer_->addRowContainer(std::move(current_result_container), std::move(current_result_container_rows));
+        results.push_back(result_container);
+        indexes.push_back(current_row_count);
+        current_result_container = op->rowContainer_->emptyRowContainer();
+        current_result_container_rows.clear();
+      }
+      // pin a new container if required
+      if (current_container_idx < remainingRecords->indexes_.size() - 1 &&  current_idx < remainingRecords->indexes_[current_container_idx + 1]) {
+        current_container_idx++;
+        current_compare_idx = 0;
+        remainingPinned = remainingRecords->sorted_containers_[current_container_idx]->pin();
+      }
+      current_result_container->copySerializedRow(remainingPinned->getRows()[current_compare_idx], remainingPinned->getRowContainer()->fixedRowSize(), variableColumns);
+      current_idx++;
+      current_compare_idx++;
+    }
+
+    return std::make_shared<OrderedContainer>(std::move(results),
+      std::vector<ContainerBounds>(),
+      std::move(indexes),
+      std::shared_ptr<RowContainer>(nullptr),
+      current_row_count);
+  }
+};
+
+
+std::shared_ptr<OrderedContainer> combine_sorted(
+  const std::shared_ptr<OrderedContainer>& a,
+  const std::shared_ptr<OrderedContainer>& b,
+  vector_size_t parallelization_threshold,
+  memory::MemoryPool* pool,
+  const OrderByMergePath* op) {
+  // If the total length of the combined vectors is less than our threshold, then
+  // we simply combine via a single thread.
+  // Otherwise, determine the total number of partitions then, calculate the
+  // merge path intersection points based on the merge path algorithm.
+  uint32_t partitions = std::max(static_cast<uint32_t>(1), static_cast<uint32_t>(std::ceil(double(a->total_records_ + b->total_records_) / parallelization_threshold)));
+  std::vector<std::pair<uint32_t, uint32_t>> merge_points(partitions);
+  if (partitions > 1) {
+    for (uint32_t i = 0; i < partitions - 1; i++) { // the final point is the end of the array.
+      merge_points[i] = DiagonalIntersection(a, b, i, partitions, op);
+    }
+    merge_points[partitions - 1] = {a->total_records_, b->total_records_};
+  } else {
+    merge_points[0] = {a->total_records_, b->total_records_};
+  }
+  // std::shared_ptr<OrderedContainer>&& a,
+  //   std::shared_ptr<OrderedContainer>&& b,
+  //   std::shared_ptr<ArrayPartition>&& a_part,
+  //   std::shared_ptr<ArrayPartition>&& b_part,
+  //   const OrderByMergePath* op
+  ArrayPartition next_a = {0,merge_points[0].first};
+  ArrayPartition next_b = {0,merge_points[0].second};
+  std::vector<SortWork> sortjobs;
+  for (int i = 0; i < merge_points.size(); i++) {
+    ArrayPartition next_a_partition = {next_a.max_idx, merge_points[i].first};
+    ArrayPartition next_b_partition = {next_b.max_idx, merge_points[i].second};
+    sortjobs.emplace_back(a, b, next_a, next_b, op);
+    next_a = next_a_partition;
+    next_b = next_b_partition;
+  }
+  std::vector<std::shared_ptr<OrderedContainer>> merged;
+  // Pre-allocate the output vector to the size of sortjobs
+  merged.resize(sortjobs.size());
+  // Use regular begin() iterator instead of back_inserter
+  std::transform(std::execution::par,
+    sortjobs.begin(),
+    sortjobs.end(),
+    merged.begin(),
+    [](SortWork& work) { return work.merge(); });
+
+  return OrderedContainer::merge(merged);
+}
+
+void OrderByMergePath::noMoreInput() {
+  // Parallel Sorting Algorithm
+  // Set up:
+    // assume all of our spilled containers are pre-sorted, create a stack of work
+  std::stack<std::shared_ptr<OrderedContainer>> ordered_containers;
+  for (const auto & container : containers_) {
+    ordered_containers.push(OrderedContainer::newContainer(container));
+  }
+  // the original container are no longer required. Clear the vec to allow releasing memory later
+  containers_.clear();
+  // now we have a stack of ordered vectors.
+  // we merge them by combining two containers together until we only have a single sorted container
+  while (ordered_containers.size() > 1) {
+    // gather all pairs of vectors, combine, and then push back to the stack.
+    std::vector<std::tuple<std::shared_ptr<OrderedContainer>, std::shared_ptr<OrderedContainer>>> pairs;
+    while (ordered_containers.size() > 1) {
+      auto a = ordered_containers.top();
+      ordered_containers.pop();
+      auto b = ordered_containers.top();
+      ordered_containers.pop();
+      pairs.emplace_back(a, b);
+    }
+
+    std::vector<std::shared_ptr<OrderedContainer>> merged;
+    // Pre-allocate the output vector to the size of pairs
+    merged.resize(pairs.size());
+    // Use regular begin() iterator instead of back_inserter
+    std::transform(
+      std::execution::par,
+      pairs.begin(),
+      pairs.end(),
+      merged.begin(),
+      [this](const auto& pair) {
+        auto a = std::get<0>(pair);
+        auto b = std::get<1>(pair);
+        return combine_sorted(a, b, maxContainerRows_, pool_, this);
+      }
+    );
+    for (auto& container : merged) {
+      ordered_containers.push(container);
+    }
+  }
+  orderedContainers_ = std::deque(ordered_containers.top()->sorted_containers_.begin(), ordered_containers.top()->sorted_containers_.end());
+  noMoreInput_ = true;
+}
+
+RowVectorPtr OrderByMergePath::getOutput() {
+  if (finished_ || !noMoreInput_) {
+    return nullptr;
+  }
+
+  if (orderedContainers_.empty()) {
+    finished_ = true;
+    return nullptr;
+  }
+  auto container = orderedContainers_.front();
+  orderedContainers_.pop_front();
+  auto pinned = container->pin();
+  RowVectorPtr output = convertSpillableToRowVectorPtr(pinned, pool_);
+  finished_ = output == nullptr;
+  if (finished_) {
+    recordSpillReadStats();
+    recordSortStats();
+  }
+
+  // this->setRuntimeMetric(
+  //     OperatorMetricKey::kTotalRowCount,
+  //     folly::to<std::string>(sortBuffer_->numInputRows()));
+  // this->setRuntimeMetric(
+  //     OperatorMetricKey::kHasBeenProcessedRowCount,
+  //     folly::to<std::string>(sortBuffer_->numOutputRows()));
+
+  return output;
+}
+
+RowVectorPtr OrderByMergePath::convertSpillableToRowVectorPtr(
+    const std::shared_ptr<PinnedRowContainer>& container,
+    MemoryPool* pool) {
+  // i is the index of the columns in the container, projectionMapping[i] is the
+  // index in the output vector
+  auto columnMap = rowContainer_->projectionMapping();
+    auto outputType = rowContainer_->inputType();
+  auto batchSize = container->getRows().size();
+  if (output_ != nullptr) {
+    VectorPtr output = std::move(output_);
+    BaseVector::prepareForReuse(output, batchSize);
+    output_ = std::static_pointer_cast<RowVector>(output);
+  } else {
+    output_ = std::static_pointer_cast<RowVector>(
+        BaseVector::create(outputType, batchSize, pool));
+  }
+
+  for (auto& child : output_->children()) {
+    child->resize(batchSize);
+  }
+
+  auto rows = container->getRows();
+  for (int i = 0; i < columnMap.size(); i++) {
+    container->getRowContainer()->extractColumn(
+        rows.data(),
+        rows.size(),
+        i,
+        output_->childAt(columnMap[i]));
+  }
+  return output_;
+}
+
+void OrderByMergePath::close() {
+  rowContainer_.reset();
+}
