+// returns < 0, 0, or >0 if the row at idx is <, =, or > than other_idx inside
+// of other aIdx and bIdx must be valid indexes into aPinned and bPinned
+// respectively.
+static bool compareLess(
+    uint64_t aIdx,
+    const std::shared_ptr<PinnedRowContainer>& aPinned,
+    uint64_t bIdx,
+    const std::shared_ptr<PinnedRowContainer>& bPinned,
+    const SortBufferMergePath*& op) {
+  char* rowA = aPinned->getRows()[aIdx];
+  char* rowB = bPinned->getRows()[bIdx];
+  if (op->cmp()) {
+    auto result = op->cmp()(rowA, rowB);
+    return result;
+  }
+  return aPinned->getRowContainer()->compareRows(
+             rowA, rowB, op->getSortCompareFlags()) < 0;
+}
+
+static bool compareLessGlobal(
+    uint64_t aGlobalIdx,
+    std::shared_ptr<OrderedContainer>& a,
+    uint64_t& aLastContainerIdx,
+    std::shared_ptr<PinnedRowContainer>& aCurrentPinned,
+    uint64_t bGlobalIdx,
+    std::shared_ptr<OrderedContainer>& b,
+    uint64_t& bLastContainerIdx,
+    std::shared_ptr<PinnedRowContainer>& bCurrentPinned,
+    const SortBufferMergePath*& op) {
+  auto [aContainerIdx, aCompareIdx] = a->getContainerIdx(aGlobalIdx);
+  auto [bContainerIdx, bCompareIdx] = b->getContainerIdx(bGlobalIdx);
+  auto aPinned = a->sortedContainers_[aContainerIdx]->pin();
+  auto bPinned = b->sortedContainers_[bContainerIdx]->pin();
+  VELOX_CHECK_LT(
+      aCompareIdx,
+      aPinned->getRows().size(),
+      "aCompareIdx out of container bounds: {}",
+      a->toString());
+  char* rowA = aPinned->getRows()[aCompareIdx];
+  VELOX_CHECK_LT(
+      bCompareIdx,
+      bPinned->getRows().size(),
+      "bCompareIdx out of container bounds: {}",
+      b->toString());
+  char* rowB = bPinned->getRows()[bCompareIdx];
+  if (op->cmp()) {
+    return op->cmp()(rowA, rowB);
+  }
+  auto& sortComplareFlags = op->getSortCompareFlags();
+  return cmpLess(rowA, rowB, aPinned->getRowContainer(), sortComplareFlags);
+}
+
+static bool verifyContainerIsSorted(
+    std::shared_ptr<OrderedContainer> a,
+    const SortBufferMergePath* op) {
+  std::shared_ptr<PinnedRowContainer> prevPin = a->sortedContainers_[0]->pin();
+  std::shared_ptr<PinnedRowContainer> currentPin;
+  bool sorted = true;
+  char* prevRow = nullptr;
+  for (auto& container : a->sortedContainers_) {
+    auto pinned = container->pin();
+    auto rowContainer = pinned->getRowContainer();
+    for (int i = 0; i < pinned->getRows().size(); i++) {
+      char* row = pinned->getRows()[i];
+      if (prevRow == nullptr) {
+        continue;
+      }
+      if (cmpLess(row, prevRow, rowContainer, op->getSortCompareFlags())) {
+        // checks if current row < prevRow
+        LOG(ERROR) << "Container is not sorted at index: " << i;
+        return false;
+      }
+      prevRow = row;
+    }
+  }
+  return sorted;
+}
