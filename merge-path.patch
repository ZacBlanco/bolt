+namespace facebook::velox::exec {
+using facebook::velox::memory::MemoryPool;
+
+// Represents the default size of a SpillableRowContainer.
+constexpr uint32_t kDefaultContainerSize = 256 * 1024 * 1024;
+
+class SpillableRowContainer;
+class OrderByRowContainer;
+
+class PinnedRowContainer {
+ public:
+  PinnedRowContainer(
+      std::shared_ptr<RowContainer> rows,
+      SpillableRowContainer* container);
+  std::shared_ptr<RowContainer> getRowContainer() {
+    return rows_;
+  }
+  ~PinnedRowContainer();
+  // If writes occurred to the underlying row container, mark it as dirty
+  // so that updates are written to disk in the case it needs to be spilled.
+  // Any changes to a container must maintain the same size as the original
+  // container.
+  void markDirty() {
+    dirty_ = true;
+  }
+
+ private:
+  std::shared_ptr<RowContainer> rows_;
+  SpillableRowContainer* container_;
+  bool dirty_;
+};
+
+class SpilledBlockFile {
+ public:
+  SpilledBlockFile(const std::string& filePath, MemoryPool* memoryPool)
+      : filePath_(filePath), pool_(memoryPool) {
+    // create empty file
+    FILE* f = fopen(filePath_.c_str(), "w");
+    // velox throw
+    VELOX_CHECK(f != nullptr, "Failed to create file: {}", filePath_);
+    fclose(f);
+  }
+  ~SpilledBlockFile() {
+    unlink(filePath_.c_str());
+  }
+  std::string getFilePath() {
+    return filePath_;
+  }
+
+  // create output stream
+  std::tuple<std::unique_ptr<std::ofstream>, std::unique_ptr<OutputStream>> createOutputStream();
+  // create input stream
+  std::unique_ptr<ByteInputStream> createInputStream();
+
+ private:
+  std::string filePath_;
+  MemoryPool* pool_;
+};
+
+// A spillable RowContainer is a RowContainer which may either be in-memory or
+// on disk at any point. To access the underlying vector, use the `pin()` method
+// to prevent the vector from being spilled to disk. Pinning may force a read
+// from disk.
+class SpillableRowContainer {
+  friend class OrderByRowContainer;
+  friend class PinnedRowContainer;
+
+ public:
+  SpillableRowContainer(uint32_t id, OrderByRowContainer* parent);
+  ~SpillableRowContainer() = default;
+
+  // Pinning this container will remove it from the LRU list in
+  // OrderByRowContainer and return a PinnedRowContainer. When the final
+  // PinnedRowContainer is destroyed, the container will be returned to the
+  // front of the LRU list.
+  std::shared_ptr<PinnedRowContainer> pin();
+
+ private:
+  std::string filePath() const;
+  void spillToDisk();
+  void loadFromDisk();
+  uint32_t id_;
+  OrderByRowContainer* parent_;
+  // Any time we load from disk, create a weak reference to the row container,
+  // we can upgrade it to a strong pointer if the rows haven't been flushed to
+  // disk already.
+  std::optional<std::shared_ptr<RowContainer>> rows_;
+  // For sorting optimizations; this represents the minimum value within the row
+  // container
+  RowVectorPtr min_; // TODO set this value when reading or before spilling
+  // For sorting optimizations; this represents the maximum value in the
+  // RowVector
+  RowVectorPtr max_; // TODO set this value when reading or before spilling
+  // This represents the path to the file on disk for this container.
+  std::optional<SpilledBlockFile> spillFile_;
+  std::atomic_bool dirty_ {false};
+  // This represents the next container in the LRU list.
+  std::weak_ptr<SpillableRowContainer> lruNext_;
+  // This represents the previous container in the LRU list.
+  std::weak_ptr<SpillableRowContainer> lruPrev_;
+  RowTypePtr spillRowType_;
+  std::shared_ptr<MemoryPool> spillMemoryPool_;
+
+  // lock is required for any operations that would occur on this container.
+  std::recursive_mutex lock_;
+};
+
+// The OrderByRowContainer maintains a vector of SpillableRowContainers. These
+// containers may be individually spilled or loaded from disk.
+class OrderByRowContainer {
+  friend class SpillableRowContainer;
+  friend class PinnedRowContainer;
+ public:
+  OrderByRowContainer(
+      const std::vector<column_index_t>& sortColumnIndices,
+      const std::vector<CompareFlags>& sortCompareFlags,
+      const RowTypePtr& inputType,
+      std::shared_ptr<facebook::velox::memory::MemoryPool> pool,
+      uint64_t maxMemory);
+  ~OrderByRowContainer();
+  // Adds a vector into this container and converts it into its own row
+  // container. May cause spilling
+  std::shared_ptr<SpillableRowContainer> addVector(
+      const RowVectorPtr& rows); // DONE
+  // Adds an existing in-memory RowContainer to the pool. May cause spilling.
+  std::shared_ptr<SpillableRowContainer> addRowContainer(
+      std::unique_ptr<RowContainer> rows); // DONE
+
+  void releaseContainer(
+      const std::shared_ptr<SpillableRowContainer>& container); // DONE
+
+  // Attempt to reclaim memory by spilling existing vectors to disk.
+  //
+  // 'requiredBytes': the amount of memory we are seeking to reclaim
+  uint64_t reclaimMemory(uint64_t requiredBytes); // DONE
+
+ private:
+  // pool for allocations
+  std::shared_ptr<facebook::velox::memory::MemoryPool> pool_;
+  uint64_t maxMemory_;
+  RowTypePtr inputType_;
+  // the storage type in the row container. Generally it is ( <sorted columns |
+  // <unsorted columns> )
+  RowTypePtr rowContainerType_;
+  // ordered list of the sorted columns as they appear in the row container
+  std::vector<TypePtr> sortedColumnTypes_;
+  // ordered list of the un-sorted fields as they appear in the row container
+  std::vector<TypePtr> nonSortedColumnTypes_;
+  // ordered vector where the index in the vector corresponds to the output
+  // type index. The value at a particular index is the input type position.
+  std::vector<size_t> projectionMapping_;
+  // type of vector spilled to disk.
+  RowTypePtr spillType_;
+
+  // Mapping of container ID to container.
+  std::unordered_map<uint64_t, std::shared_ptr<SpillableRowContainer>>
+      containers_;
+
+  // LRU list pointers. This should only contain containers which are not
+  // spilled to disk.
+  // head is most-recently used
+  std::weak_ptr<SpillableRowContainer> head_;
+  // tail is least-recently used
+  std::weak_ptr<SpillableRowContainer> tail_;
+
+  // this method locks the class, ensure that no lock is held before calling
+  void addToLRU(
+      const std::shared_ptr<SpillableRowContainer>& container); // DONE
+  // this method locks the class, ensure that no lock is held before calling
+  void removeFromLRU(
+      const std::shared_ptr<SpillableRowContainer>& container); // DONE
+  void checkMemoryUsage(); // DONE
+
+  // lock required when making modifications to containers_ or any part of the
+  // LRU list.
+  std::recursive_mutex lock_;
+  std::atomic<uint64_t> idCounter_;
+  std::atomic<uint64_t> memoryCounter_;
+};
+
+} // namespace facebook::velox::exec
