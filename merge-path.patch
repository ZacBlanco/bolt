+class SortBufferMergePath : public ISortBuffer {
+  friend class SortWork;
+
+ public:
+  SortBufferMergePath(
+      const RowTypePtr& input,
+      const std::vector<column_index_t>& sortColumnIndices,
+      const std::vector<CompareFlags>& sortCompareFlags,
+      MemoryPool* pool,
+      const core::QueryConfig* queryConfig,
+      const common::SpillConfig* spillConfig = nullptr,
+      folly::Executor* mergeExecutor = nullptr,
+      folly::Executor* combineExecutor = nullptr);
+
+  void addInput(const VectorPtr& input) override;
+
+  void noMoreInput() override;
+
+  RowVectorPtr getOutput(uint32_t maxOutputRows) override;
+
+  bool isFinished() const {
+    return finished_;
+  }
+
+  void reclaim(uint64_t targetBytes) override;
+
+  std::optional<uint64_t> estimateOutputRowSize() const override;
+  size_t numInputRows() override;
+  size_t numOutputRows() override;
+  std::optional<common::SpillStats> spilledStats() const override;
+  std::optional<common::SpillReadStats> spillReadStats() const override;
+  std::optional<common::SortStats> sortStats() const override;
+
+  void close();
+  const std::vector<CompareFlags>& getSortCompareFlags() const {
+    return sortCompareFlags_;
+  }
+  folly::Executor* combineExecutor() const;
+
+ private:
+  RowVectorPtr convertSpillableToRowVectorPtr(
+      const std::shared_ptr<PinnedRowContainer>& container,
+      MemoryPool* pool);
+  void waitForPendingTasks();
+  void addSortTask(const VectorPtr& vector);
+
+  MemoryPool* pool_;
+  std::unique_ptr<OrderByRowContainer> rowContainer_;
+  std::vector<std::shared_ptr<SpillableRowContainer>> containers_;
+  std::mutex containersLock_;
+  uint32_t pendingTasks_{0};
+  uint32_t vectorCount_{0};
+  uint32_t parallelism_;
+  std::vector<VectorPtr> inputVectors_;
+  uint64_t inputVectorMemoryLimit_;
+  std::mutex addInputTasksMutex_;
+  std::condition_variable addInputTasksCv_;
+  std::vector<CompareFlags> sortCompareFlags_;
+  std::deque<std::shared_ptr<SpillableRowContainer>> orderedContainers_;
+  RowVectorPtr output_;
+  HybridSorter sorter_;
+  bool finished_ = false;
+  bool noMoreInput_ = false;
+  uint32_t targetContainerMemory_;
+  uint64_t targetParallelRows_;
+  std::unique_ptr<folly::Executor> mergeExecutor_;
+  std::unique_ptr<folly::Executor> combineExecutor_;
+  size_t numInputRows_ = 0;
+  size_t numOutputRows_ = 0;
+  std::optional<uint64_t> estimatedOutputRowSize_;
+  std::atomic_uint64_t blockedOnSortingNoMoreInputTimer_;
+  std::atomic_uint64_t blockedOnCalculatingDiagionalTimer_;
+};
+
+struct ContainerBounds {
+  char* minRow_;
+  char* maxRow_;
+};
+
+class OrderedContainer {
+ public:
+  OrderedContainer(
+      uint64_t totalRecords,
+      std::vector<std::shared_ptr<SpillableRowContainer>>&& containers,
+      std::vector<ContainerBounds>&& partitions,
+      std::vector<uint64_t>&& indexes,
+      std::shared_ptr<RowContainer>&& partitionBoundsRowContainer_);
+  // this vector should maintain the following invariant:
+  // max(sorted_containers_[i]) <= min(sorted_containers_[i + 1])
+  std::vector<std::shared_ptr<SpillableRowContainer>> sortedContainers_;
+  // This should always have the same number of values as the sorted_containers_
+  // vector
+  std::vector<ContainerBounds> partitions_;
+  // represents the absolute index of the first record in the sorted_containers_
+  // vector
+  std::vector<uint64_t> indexes_;
+  std::shared_ptr<RowContainer> partitionBoundsRowContainer_;
+  std::uint64_t totalRecords_{0};
+
+  // accepts an absolute index across all of the internal containers.
+  // returns a pair of indexes representing (1) The index of the sorted
+  // container in the internal sorted_containers_ list. And (2) The index within
+  // the container itself.
+  static std::pair<uint64_t, uint64_t> getContainerIdx(
+      uint64_t idx,
+      const std::vector<uint64_t>& indexes);
+  std::pair<uint64_t, uint64_t> getContainerIdx(uint64_t idx) const;
+  static std::shared_ptr<OrderedContainer> newContainer(
+      std::shared_ptr<SpillableRowContainer> container);
+  // Flattens multiple ordered containers into a single ordered container.
+  static std::shared_ptr<OrderedContainer> merge(
+      const std::vector<std::shared_ptr<OrderedContainer>>& containers);
+};
+
