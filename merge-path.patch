+void sortPinned(
+    const std::shared_ptr<PinnedRowContainer>& pinned,
+    HybridSorter& sorter,
+    const std::vector<CompareFlags>& sortCompareFlags) {
+  auto container = pinned->getRowContainer();
+  auto& rows = pinned->getRows();
+  sorter.template sort(
+      rows.begin(),
+      rows.end(),
+      [container, sortCompareFlags](const char* leftRow, const char* rightRow) {
+        for (vector_size_t index = 0; index < sortCompareFlags.size();
+             ++index) {
+          if (auto result = container->compare(
+                  leftRow, rightRow, index, sortCompareFlags[index])) {
+            return result < 0;
+          }
+        }
+        return false;
+      });
+}
+
+void SortBufferMergePath::addSortTask(const VectorPtr& vector) {
+  {
+    std::lock_guard lock(addInputTasksMutex_);
+    pendingTasks_++;
+  }
+
+  mergeExecutor_->add([vector, this]() {
+auto container = rowContainer_->addVector(vector);
+auto pinned = container->pin();
+sortPinned(pinned, sorter_, sortCompareFlags_);
+{
+  std::lock_guard<std::mutex> lock(containersLock_);
+  containers_.push_back(container);
+}
+// Decrement pending tasks and notify if all are complete
+{
+std::lock_guard lock(addInputTasksMutex_);
+pendingTasks_--;
+if (pendingTasks_ == 0) {
+  addInputTasksCv_.notify_one();
+}
+}
+});
+}
+
+void SortBufferMergePath::addInput(const VectorPtr& input) {
+  // vector must be loaded before potentially sending off to other
+  // threads for sorting
+  input->loadedVector();
+  size_t workerIdx = vectorCount_ % parallelism_;
+  bool addedVector = false;
+  {
+    std::lock_guard lock(addInputTasksMutex_);
+    vectorCount_++;
+    if (inputVectors_[workerIdx] == nullptr) {
+      inputVectors_[workerIdx] = input;
+      addedVector = true;
+    }
+  }
+
+  if (!addedVector) {
+    // check if we need to send the vector off for sorting.
+    // if so, send it off. Afterwards, set the new inputVector_ here to the new vector.
+    // Otherwise, append the new vector to the current one.
+    if (inputVectors_[workerIdx]->estimateFlatSize() > inputVectorMemoryLimit_) {
+      VectorPtr rowInput = inputVectors_[workerIdx];
+      inputVectors_[workerIdx] = input;
+      addSortTask(rowInput);
+    } else {
+      // append to current vector
+      inputVectors_[workerIdx]->append(input.get());
+    }
+  }
+
+
+
+  numInputRows_ += input->size();
+}
