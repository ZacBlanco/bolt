+std::shared_ptr<OrderedContainer> OrderedContainer::newContainer(
+    std::shared_ptr<SpillableRowContainer> container) {
+  auto records = container->numRows();
+  return std::make_shared<OrderedContainer>(
+      records,
+      std::vector{std::move(container)},
+      std::vector<ContainerBounds>{},
+      std::vector<uint64_t>{0},
+      std::shared_ptr<RowContainer>(nullptr));
+}
+
+std::shared_ptr<OrderedContainer> OrderedContainer::merge(
+    const std::vector<std::shared_ptr<OrderedContainer>>& containers) {
+  // compute new total_records_ for the merged container.
+  std::uint64_t newTotalRecords = 0;
+  for (auto& container : containers) {
+    newTotalRecords += container->totalRecords_;
+  }
+  // compute new indexes_ for the merged container.
+  // the first container maintains it's indexes array. The subsequent indexes
+  // are concatenated on to the new index array, but their values are offset
+  // by the total_records_ of the previous containers.
+  std::vector<uint64_t> newIndexes = containers[0]->indexes_;
+  uint64_t currentTotalRecords = containers[0]->totalRecords_;
+  // skip first container in loop
+  for (auto& container : containers) {
+    if (container == containers[0]) {
+      continue;
+    }
+    // transform all indexes in container by adding the total_records_ of the
+    // previous container.
+    std::vector<uint64_t> tmpIndexes(container->indexes_.size());
+    std::transform(
+        container->indexes_.begin(),
+        container->indexes_.end(),
+        tmpIndexes.begin(),
+        [currentTotalRecords](uint64_t idx) {
+          return idx + currentTotalRecords;
+        });
+    newIndexes.insert(newIndexes.end(), tmpIndexes.begin(), tmpIndexes.end());
+    currentTotalRecords += container->totalRecords_;
+  }
+
+  // concatenate all internal containers
+  std::vector<std::shared_ptr<SpillableRowContainer>> newSortedContainers;
+  for (auto& container : containers) {
+    newSortedContainers.insert(
+        newSortedContainers.end(),
+        container->sortedContainers_.begin(),
+        container->sortedContainers_.end());
+  }
+  return std::make_shared<OrderedContainer>(
+      newTotalRecords,
+      std::move(newSortedContainers),
+      std::vector<ContainerBounds>(),
+      std::move(newIndexes),
+      std::shared_ptr<RowContainer>(nullptr));
+}
+
+// returns -1, 0, or 1 if the row at idx is <, =, or > than other_idx inside of
+// other
+// aIdx and bIdx must be valid indexes into aPinned and bPinned respectively.
+int8_t compare(
+    uint64_t aIdx,
+    const std::shared_ptr<PinnedRowContainer>& aPinned,
+    uint64_t bIdx,
+    const std::shared_ptr<PinnedRowContainer>& bPinned,
+    const SortBufferMergePath*& op) {
+  // technically, compareRows is meant to compare rows in the same container,
+  // but since we know all containers have the same types, the rows can still be
+  // compared without issue since the comparison doesn't rely on any
+  // container-specific data.
+  char* row_a = aPinned->getRows()[aIdx];
+  char* row_b = bPinned->getRows()[bIdx];
+  return aPinned->getRowContainer()->compareRows(
+      row_a, row_b, op->getSortCompareFlags());
+}
+
+// Algorithm 2 of Merge Paths paper on p.7 (https://arxiv.org/pdf/1406.2628)
+// calculate the diagonal intersection of 2 ordered containers.
+// Returns a pair of <a_start, b_start>. This represents the starting index of
+// the intersection in each container.
+std::pair<uint32_t, uint32_t> DiagonalIntersection(
+    std::shared_ptr<OrderedContainer> a,
+    std::shared_ptr<OrderedContainer> b,
+    const uint32_t threadId,
+    const uint32_t parallelizationThreshold,
+    const SortBufferMergePath* op) {
+  const uint32_t diag = (threadId + 1) * (a->totalRecords_ + b->totalRecords_) /
+      parallelizationThreshold;
+  uint32_t aTop;
+  uint32_t bTop;
+  uint32_t aStart = 0;
+  uint32_t bStart = 0;
+  if (diag > a->totalRecords_) {
+    aTop = a->totalRecords_;
+    bTop = diag - a->totalRecords_;
+  } else {
+    aTop = diag;
+    bTop = 0;
+  }
+  uint32_t aBottom = bTop;
+
+  // We will only pin 2 containers at a time
+  std::shared_ptr<PinnedRowContainer> aContainer;
+  std::shared_ptr<PinnedRowContainer> bContainer;
+  uint32_t aContainerIdx = 0;
+  uint32_t bContainerIdx = 0;
+  while (true) {
+    // We want signed integer subtraction to avoid overflow
+    int32_t offset =
+        (static_cast<int32_t>(aTop) - static_cast<int32_t>(aBottom)) / 2;
+    uint32_t a_i = aTop - offset;
+    uint32_t b_i = bTop + offset;
+    auto [aIdx, aCompareIdx] = a->getContainerIdx(a_i);
+    auto [bIdx, bCompareIdx] = b->getContainerIdx(b_i - 1);
+    // pin the containers if necessary
+    if (aContainerIdx != aIdx || aContainer == nullptr) {
+      aContainer = a->sortedContainers_[aIdx]->pin();
+      aContainerIdx = aIdx;
+    }
+    if (bContainerIdx != bIdx || bContainer == nullptr) {
+      bContainer = b->sortedContainers_[bIdx]->pin();
+      bContainerIdx = bIdx;
+    }
+    // compare A[a_i] > B[b_i - 1]
+    if (compare(aCompareIdx, aContainer, bCompareIdx, bContainer, op) > 0) {
+      auto [a_idx, a_compare_idx] = a->getContainerIdx(a_i - 1);
+      auto [b_idx, b_compare_idx] = b->getContainerIdx(b_i);
+      // pin the containers if necessary
+      if (aContainerIdx != a_idx || aContainer == nullptr) {
+        aContainer = a->sortedContainers_[a_idx]->pin();
+        aContainerIdx = a_idx;
+      }
+      if (bContainerIdx != b_idx || bContainer == nullptr) {
+        bContainer = b->sortedContainers_[b_idx]->pin();
+        bContainerIdx = b_idx;
+      }
+      // compare A[a_i - 1] <= B[b_i]
+      if (compare(a_compare_idx, aContainer, b_compare_idx, bContainer, op) <=
+          0) {
+        aStart = a_i;
+        bStart = b_i;
+        break;
+      }
+      aTop = a_i - 1;
+      bTop = b_i + 1;
+    } else {
+      aBottom = a_i + 1;
+    }
+  }
+  return {aStart, bStart};
+}
+
+static int8_t compareGlobal(
+    uint64_t aGlobalIdx,
+    std::shared_ptr<OrderedContainer>& a,
+    uint64_t& aLastContainerIdx,
+    std::shared_ptr<PinnedRowContainer>& aCurrentPinned,
+    uint64_t bGlobalIdx,
+    std::shared_ptr<OrderedContainer>& b,
+    uint64_t& bLastContainerIdx,
+    std::shared_ptr<PinnedRowContainer>& bCurrentPinned,
+    const SortBufferMergePath*& op) {
+  auto [aContainerIdx, aCompareIdx] = a->getContainerIdx(aGlobalIdx);
+  auto [bContainerIdx, bCompareIdx] = b->getContainerIdx(bGlobalIdx);
+  if (aContainerIdx != aLastContainerIdx || aCurrentPinned == nullptr) {
+    aCurrentPinned = a->sortedContainers_[aContainerIdx]->pin();
+    aLastContainerIdx = aContainerIdx;
+  }
+  if (bContainerIdx != bLastContainerIdx || bCurrentPinned == nullptr) {
+    bCurrentPinned = b->sortedContainers_[bContainerIdx]->pin();
+    bLastContainerIdx = bContainerIdx;
+  }
+  return compare(aCompareIdx, aCurrentPinned, bCompareIdx, bCurrentPinned, op);
+}
+
+static std::pair<uint32_t, uint32_t> DiagonalIntersection2(
+    std::shared_ptr<OrderedContainer> a,
+    std::shared_ptr<OrderedContainer> b,
+    const uint32_t threadId,
+    const uint32_t parallelizationThreshold,
+    const SortBufferMergePath* op) {
+  const uint64_t diag = (threadId + 1) * (a->totalRecords_ + b->totalRecords_) /
+      parallelizationThreshold;
+  uint64_t aOffset;
+  uint64_t bOffset;
+  uint64_t aStart = 0;
+  uint64_t bStart = 0;
+  if (diag > a->totalRecords_) {
+    aOffset = a->totalRecords_;
+    bOffset = diag - a->totalRecords_;
+  } else {
+    aOffset = diag;
+    bOffset = 0;
+  }
+  const uint64_t searchSpace =
+      diag > std::max(a->totalRecords_, b->totalRecords_)
+      ? a->totalRecords_ + b->totalRecords_ - diag
+      : std::min(diag, std::min(a->totalRecords_, b->totalRecords_));
+  // We will only pin 2 containers at a time
+  std::shared_ptr<PinnedRowContainer> aContainer;
+  std::shared_ptr<PinnedRowContainer> bContainer;
+  uint64_t aContainerIdx = 0;
+  uint64_t bContainerIdx = 0;
+  uint64_t ai = 0;
+  uint64_t bi = searchSpace - 1;
+  uint64_t middle;
+  auto comp = 0;
+  while (ai <= bi) {
+    middle = (ai + bi) / 2;
+    aStart = aOffset - middle;
+    bStart = bOffset + middle;
+    if (aStart == a->totalRecords_ || bStart == 0) {
+      comp = compareGlobal(
+          aStart - 1,
+          a,
+          aContainerIdx,
+          aContainer,
+          bStart,
+          b,
+          bContainerIdx,
+          bContainer,
+          op);
+      if (comp > 0) {
+        aStart--;
+        bStart++;
+      } else {
+        return {aStart, bStart};
+      }
+      if (aStart == 0 || bStart == b->totalRecords_) {
+        return {aStart, bStart};
+      } else {
+        break;
+      }
+    }
+    comp = compareGlobal(
+        aStart,
+        a,
+        aContainerIdx,
+        aContainer,
+        bStart,
+        b,
+        bContainerIdx,
+        bContainer,
+        op);
+    if (comp > 0) {
+      ai = middle + 1;
+    } else {
+      bi = middle - 1;
+    }
+  }
+  // int l_r_min1 = CompareUsingGlobalIndex(*left, *right, l_idx, r_idx - 1);
+  int8_t lrm1 = compareGlobal(
+      aStart,
+      a,
+      aContainerIdx,
+      aContainer,
+      bStart - 1,
+      b,
+      bContainerIdx,
+      bContainer,
+      op);
+  // int l_min1_r = CompareUsingGlobalIndex(*left, *right, l_idx - 1, r_idx);
+  int8_t lm1r = compareGlobal(
+      aStart - 1,
+      a,
+      aContainerIdx,
+      aContainer,
+      bStart,
+      b,
+      bContainerIdx,
+      bContainer,
+      op);
+  if (lrm1 > 0 && lm1r < 0) {
+    return {aStart, bStart};
+  }
+
+  if (lrm1 > 0) {
+    // l_idx--;
+    aStart--;
+    // r_idx++;
+    bStart++;
+  } else if (lm1r < 0) {
+    // l_idx++;
+    aStart++;
+    // r_idx--;
+    bStart--;
+  }
+  return {aStart, bStart};
+}
+
+class SortWork {
+ public:
+  std::shared_ptr<OrderedContainer> a;
+  std::shared_ptr<OrderedContainer> b;
+  ArrayPartition aPart;
+  ArrayPartition bPart;
+  const SortBufferMergePath* op;
+  SortWork(
+      std::shared_ptr<OrderedContainer> a,
+      std::shared_ptr<OrderedContainer> b,
+      ArrayPartition aPart,
+      ArrayPartition bPart,
+      const SortBufferMergePath* op)
+      : a(std::move(a)), b(std::move(b)), aPart(aPart), bPart(bPart), op(op) {}
+
+  std::shared_ptr<OrderedContainer> merge() {
+    // absolute indexes within entire sorted container
+    uint32_t aCurrent = aPart.minIdx;
+    uint32_t bCurrent = bPart.minIdx;
+    // current result container
+    std::unique_ptr<RowContainer> currentResultContainer =
+        op->rowContainer_->emptyRowContainer();
+    std::vector<char*> currentResultContainerRows;
+    uint64_t currentRowCount = 0;
+    std::vector<std::shared_ptr<SpillableRowContainer>> results;
+    std::vector<uint64_t> indexes;
+    // first container always starts at 0
+    indexes.push_back(0);
+    // *_idx is the index of the container in the sorted_containers_ vector
+    // *_compare_idx is the relative index of the element in the container which
+    // should be compared.
+    auto [aIdx, aCompareIdx] = a->getContainerIdx(aCurrent);
+    auto [bIdx, bCompareIdx] = b->getContainerIdx(bCurrent);
+    // pin the containers if necessary
+    auto aContainer = a->sortedContainers_[aIdx]->pin();
+    auto bContainer = b->sortedContainers_[bIdx]->pin();
+    std::vector<std::pair<bool, RowColumn>> variableColumns;
+    // populate variableColumns vector for row copy function.
+    for (int i = 0; i < aContainer->getRowContainer()->columnTypes().size();
+         i++) {
+      auto type = aContainer->getRowContainer()->columnTypes()[i];
+      if (!type->isFixedWidth()) {
+        bool isStringType = type->kind() == TypeKind::VARCHAR ||
+            type->kind() == TypeKind::VARBINARY;
+        variableColumns.emplace_back(
+            isStringType, aContainer->getRowContainer()->columns()[i]);
+      }
+    }
+    while (aCurrent < aPart.maxIdx && bCurrent < bPart.maxIdx) {
+      // check if a new result container needs to be created.
+      if (currentResultContainer->allocatedBytes() >=
+          op->targetContainerMemory_) {
+        std::shared_ptr<SpillableRowContainer> resultContainer =
+            op->rowContainer_->addRowContainer(
+                std::move(currentResultContainer),
+                std::move(currentResultContainerRows));
+        results.push_back(resultContainer);
+        indexes.push_back(currentRowCount);
+        currentResultContainer = op->rowContainer_->emptyRowContainer();
+        currentResultContainerRows.clear();
+      }
+
+      // *_compare_idx should be less than the size of the current pinned
+      // container. otherwise, pin a new container, increment a_idx and reset
+      // a_compare_idx to 0.
+      if (aIdx < a->indexes_.size() - 1 && aCurrent >= a->indexes_[aIdx + 1]) {
+        aIdx++;
+        aCompareIdx = 0;
+        aContainer = a->sortedContainers_[aIdx]->pin();
+      }
+      if (bIdx < b->indexes_.size() - 1 && bCurrent >= b->indexes_[bIdx + 1]) {
+        bIdx++;
+        bCompareIdx = 0;
+        bContainer = b->sortedContainers_[bIdx]->pin();
+      }
+      // compare
+      if (compare(aCompareIdx, aContainer, bCompareIdx, bContainer, op) <= 0) {
+        currentResultContainerRows.push_back(
+            currentResultContainer->copySerializedRow(
+                aContainer->getRows()[aCompareIdx],
+                aContainer->getRowContainer()->fixedRowSize(),
+                variableColumns));
+        aCurrent++;
+        aCompareIdx++;
+      } else {
+        currentResultContainerRows.push_back(
+            currentResultContainer->copySerializedRow(
+                bContainer->getRows()[bCompareIdx],
+                bContainer->getRowContainer()->fixedRowSize(),
+                variableColumns));
+        bCurrent++;
+        bCompareIdx++;
+      }
+      currentRowCount++;
+    }
+    // there may be rows left in a or b. Copy the remaining rows from the
+    // current idx in the remaining vector into the final result containers.
+    uint64_t currentIdx;
+    uint64_t currentContainerIdx;
+    uint64_t currentCompareIdx;
+    uint64_t maxIdx;
+    std::shared_ptr<OrderedContainer> remainingRecords;
+    std::shared_ptr<PinnedRowContainer> remainingPinned;
+    if (aCurrent < aPart.maxIdx) {
+      currentIdx = aCurrent;
+      currentContainerIdx = aIdx;
+      currentCompareIdx = aCompareIdx;
+      maxIdx = aPart.maxIdx;
+      remainingRecords = a;
+      remainingPinned = aContainer;
+    } else {
+      currentIdx = bCurrent;
+      currentContainerIdx = bIdx;
+      currentCompareIdx = bCompareIdx;
+      maxIdx = bPart.maxIdx;
+      remainingRecords = b;
+      remainingPinned = bContainer;
+    }
+    while (currentIdx < maxIdx) {
+      // create a new result container if required
+      if (currentResultContainer->allocatedBytes() >=
+          op->targetContainerMemory_) {
+        std::shared_ptr<SpillableRowContainer> resultContainer =
+            op->rowContainer_->addRowContainer(
+                std::move(currentResultContainer),
+                std::move(currentResultContainerRows));
+        results.push_back(resultContainer);
+        indexes.push_back(currentRowCount);
+        currentResultContainer = op->rowContainer_->emptyRowContainer();
+        currentResultContainerRows.clear();
+      }
+      // pin a new container if required
+      if (currentContainerIdx < remainingRecords->indexes_.size() - 1 &&
+          currentIdx >= remainingRecords->indexes_[currentContainerIdx + 1]) {
+        currentContainerIdx++;
+        currentCompareIdx = 0;
+        remainingPinned =
+            remainingRecords->sortedContainers_[currentContainerIdx]->pin();
+      }
+      // Add safety check to prevent out-of-bounds access
+      VELOX_CHECK(currentCompareIdx < remainingPinned->getRows().size());
+      currentResultContainerRows.push_back(
+          currentResultContainer->copySerializedRow(
+              remainingPinned->getRows()[currentCompareIdx],
+              remainingPinned->getRowContainer()->fixedRowSize(),
+              variableColumns));
+      currentIdx++;
+      currentCompareIdx++;
+      currentRowCount++;
+    }
+    if (currentResultContainer->numRows() > 0) {
+      std::shared_ptr<SpillableRowContainer> resultContainer =
+          op->rowContainer_->addRowContainer(
+              std::move(currentResultContainer),
+              std::move(currentResultContainerRows));
+      results.push_back(resultContainer);
+    }
+
+    return std::make_shared<OrderedContainer>(
+        currentRowCount,
+        std::move(results),
+        std::vector<ContainerBounds>(),
+        std::move(indexes),
+        std::shared_ptr<RowContainer>(nullptr));
+  }
+};
+
+static  std::shared_ptr<OrderedContainer> combineSorted(
+    const std::shared_ptr<OrderedContainer>& a,
+    const std::shared_ptr<OrderedContainer>& b,
+    vector_size_t parallelizationThreshold,
+    const SortBufferMergePath* op) {
+  // If the total length of the combined vectors is less than our threshold,
+  // then we simply combine via a single thread. Otherwise, determine the total
+  // number of partitions then, calculate the merge path intersection points
+  // based on the merge path algorithm.
+  uint32_t partitions = std::max(
+      static_cast<uint32_t>(1),
+      static_cast<uint32_t>(std::ceil(
+          double(a->totalRecords_ + b->totalRecords_) /
+          parallelizationThreshold)));
+  std::vector<std::pair<uint32_t, uint32_t>> mergePoints(partitions);
+  if (partitions > 1) {
+    for (uint32_t i = 0; i < partitions - 1;
+         i++) { // the final point is the end of the array.
+      mergePoints[i] = DiagonalIntersection2(a, b, i, partitions, op);
+    }
+    mergePoints[partitions - 1] = {a->totalRecords_, b->totalRecords_};
+  } else {
+    mergePoints[0] = {a->totalRecords_, b->totalRecords_};
+  }
+
+  uint32_t lastAPoint = 0;
+  uint32_t lastBPoint = 0;
+  std::vector<SortWork> sortJobs;
+  for (int i = 0; i < mergePoints.size(); i++) {
+    ArrayPartition nextAPartition = {.minIdx=lastAPoint, .maxIdx=mergePoints[i].first};
+    ArrayPartition nextBPartition = {.minIdx=lastBPoint, .maxIdx=mergePoints[i].second};
+    sortJobs.emplace_back(a, b, nextAPartition, nextBPartition, op);
+    lastAPoint = nextAPartition.maxIdx;
+    lastBPoint = nextBPartition.maxIdx;
+  }
+
+  std::vector<std::shared_ptr<OrderedContainer>> merged;
+  merged.reserve(sortJobs.size());
+
+  // Submit all tasks to executor and collect futures
+  std::vector<folly::Future<std::shared_ptr<OrderedContainer>>> futures;
+  futures.reserve(sortJobs.size());
+
+  for (auto& work : sortJobs) {
+    futures.push_back(
+        folly::via(op->combineExecutor(), [&work]() { return work.merge(); }));
+  }
+
+  // Wait for all futures to complete and collect results in order
+  for (auto& future : futures) {
+    merged.push_back(std::move(future).get());
+  }
+
+  return OrderedContainer::merge(merged);
+}
+
+void SortBufferMergePath::waitForPendingTasks() {
+  std::unique_lock<std::mutex> lock(addInputTasksMutex_);
+  addInputTasksCv_.wait(lock, [this]() { return pendingTasks_ == 0; });
+}
+
+folly::Executor* SortBufferMergePath::combineExecutor() const {
+  return combineExecutor_.get();
+}
+
+void SortBufferMergePath::noMoreInput() {
+
+  // collect the remaining vectors, sort them, and then append them to the
+  // current vector.
+  for (auto& vector : inputVectors_) {
+    if (vector != nullptr) {
+      addSortTask(vector);
+    }
+  }
+
+  // make sure no more tasks from addInput are executing:
+  LOG(ERROR) << "noMoreInput called";
+  uint64_t usecs = 0;
+  {
+    MicrosecondTimer timer(&usecs);
+    waitForPendingTasks();
+  }
+  blockedOnSortingNoMoreInputTimer_ += usecs;
+
+  // Parallel Sorting Algorithm
+  // Set up:
+  // assume all of our spilled containers are pre-sorted, create a stack of work
+  std::stack<std::shared_ptr<OrderedContainer>> orderedContainers;
+  for (const auto& container : containers_) {
+    orderedContainers.push(OrderedContainer::newContainer(container));
+  }
+  // the original container are no longer required. Clear the vec to allow
+  // releasing memory later
+  containers_.clear();
+  // now we have a stack of ordered vectors.
+  // we merge them by combining two containers together until we only have a
+  // single sorted container
+  usecs = 0;
+  while (orderedContainers.size() > 1) {
+    usecs = 0;
+    MicrosecondTimer iterationTime(&usecs);
+    // gather all pairs of vectors, combine, and then push back to the stack.
+    std::vector<std::tuple<
+        std::shared_ptr<OrderedContainer>,
+        std::shared_ptr<OrderedContainer>>>
+        pairs;
+    while (orderedContainers.size() > 1) {
+      auto a = orderedContainers.top();
+      orderedContainers.pop();
+      auto b = orderedContainers.top();
+      orderedContainers.pop();
+      pairs.emplace_back(a, b);
+    }
+
+    std::vector<std::shared_ptr<OrderedContainer>> merged;
+    merged.reserve(pairs.size());
+
+    // Submit all tasks to executor and collect futures
+    std::vector<folly::Future<std::shared_ptr<OrderedContainer>>> futures;
+    futures.reserve(pairs.size());
+
+    for (const auto& pair : pairs) {
+      futures.push_back(folly::via(mergeExecutor_.get(), [this, pair]() {
+        auto a = std::get<0>(pair);
+        auto b = std::get<1>(pair);
+        return combineSorted(a, b, targetParallelRows_, this);
+      }));
+    }
+
+    // Wait for all futures to complete and collect results in order
+    for (auto& future : futures) {
+      merged.push_back(std::move(future).get());
+    }
+
+    // Push merged containers back to stack in the order of sort jobs
+    for (auto& container : merged) {
+      orderedContainers.push(container);
+    }
+  }
+  orderedContainers_ = std::deque(
+      orderedContainers.top()->sortedContainers_.begin(),
+      orderedContainers.top()->sortedContainers_.end());
+  noMoreInput_ = true;
+}
+
+RowVectorPtr SortBufferMergePath::getOutput(uint32_t maxOutputRows) {
+  if (finished_ || !noMoreInput_) {
+    return nullptr;
+  }
+
+  if (orderedContainers_.empty()) {
+    finished_ = true;
+    return nullptr;
+  }
+  auto container = orderedContainers_.front();
+  orderedContainers_.pop_front();
+  auto pinned = container->pin();
+  estimatedOutputRowSize_ = pinned->getRowContainer()->estimateRowSize();
+  RowVectorPtr output = convertSpillableToRowVectorPtr(pinned, pool_);
+  finished_ = output == nullptr;
+
+  return output;
+}
+
+RowVectorPtr SortBufferMergePath::convertSpillableToRowVectorPtr(
+    const std::shared_ptr<PinnedRowContainer>& container,
+    MemoryPool* pool) {
+  // i is the index of the columns in the container, projectionMapping[i] is the
+  // index in the output vector
+  auto columnMap = rowContainer_->projectionMapping();
+  auto outputType = rowContainer_->inputType();
+  auto batchSize = container->getRows().size();
+  if (output_ != nullptr) {
+    VectorPtr output = std::move(output_);
+    BaseVector::prepareForReuse(output, batchSize);
+    output_ = std::static_pointer_cast<RowVector>(output);
+  } else {
+    output_ = std::static_pointer_cast<RowVector>(
+        BaseVector::create(outputType, batchSize, pool));
+  }
+
+  for (auto& child : output_->children()) {
+    child->resize(batchSize);
+  }
+
+  auto rows = container->getRows();
+  for (int i = 0; i < columnMap.size(); i++) {
+    container->getRowContainer()->extractColumn(
+        rows.data(), rows.size(), i, output_->childAt(columnMap[i]));
+  }
+  return output_;
+}
+
+void SortBufferMergePath::close() {
+  rowContainer_.reset();
+}
+
+size_t SortBufferMergePath::numInputRows() {
+  return numInputRows_;
+}
+
+size_t SortBufferMergePath::numOutputRows() {
+  return numOutputRows_;
+}
+
+std::optional<uint64_t> SortBufferMergePath::estimateOutputRowSize() const {
+  return estimatedOutputRowSize_;
+}
+
+std::optional<common::SpillStats> SortBufferMergePath::spilledStats() const {
+  return {};
+}
+std::optional<common::SpillReadStats> SortBufferMergePath::spillReadStats()
+    const {
+  return {};
+}
+std::optional<common::SortStats> SortBufferMergePath::sortStats() const {
+  return {};
+}
