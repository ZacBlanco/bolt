+#include "velox/exec/RowContainer.h"
+#include "velox/exec/Spiller.h"
+namespace facebook::velox::exec {
+
+
+class OrderByMergePath {
+  friend class SortWork;
+ public:
+  OrderByMergePath(
+  const RowTypePtr& input,
+  const std::vector<column_index_t>& sortColumnIndices,
+  const std::vector<CompareFlags>& sortCompareFlags,
+  velox::memory::MemoryPool* pool,
+  tsan_atomic<bool>* nonReclaimableSection,
+  const common::SpillConfig* spillConfig = nullptr,
+  uint64_t spillMemoryThreshold = 0,
+  OperatorCtx* operatorCtx = nullptr);
+
+  void addInput(RowVectorPtr input) ;
+
+  void noMoreInput() ;
+
+  RowVectorPtr getOutput() ;
+
+  bool isFinished()  {
+    return finished_;
+  }
+
+  void reclaim(uint64_t targetBytes, memory::MemoryReclaimer::Stats& stats);
+
+  void close();
+  const std::vector<CompareFlags>& getSortCompareFlags() const {
+    return sortCompareFlags_;
+  }
+
+ private:
+  // Invoked to record the spilling stats in operator stats after processing all
+  // the inputs.
+  void recordSpillStats();
+  void recordSpillReadStats();
+  void recordSortStats();
+  RowVectorPtr convertSpillableToRowVectorPtr(const std::shared_ptr<PinnedRowContainer>& container,
+    MemoryPool* pool);
+
+  MemoryPool* pool_;
+  std::unique_ptr<OrderByRowContainer> rowContainer_;
+  std::vector<std::shared_ptr<SpillableRowContainer>> containers_;
+  std::vector<CompareFlags> sortCompareFlags_;
+  std::deque<std::shared_ptr<SpillableRowContainer>> orderedContainers_;
+  RowVectorPtr output_;
+  HybridSorter sorter_;
+  bool finished_ = false;
+  bool noMoreInput_ = false;
+  uint32_t maxContainerRows_;
+  uint32_t maxOutputRows_;
+};
+} // namespace facebook::velox::exec
