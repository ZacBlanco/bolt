+TEST_F(SortBufferMergePathTest, sortShuffled) {
+  std::unordered_map<std::string, std::string> configs = {
+      {core::QueryConfig::kOrderByMergePathParallelism, "4"}};
+  auto queryConfig = core::QueryConfig(configs);
+  auto spillDirectory = exec::test::TempDirectoryPath::create();
+  auto spillConfig = common::SpillConfig(
+      [&]() -> const std::string& { return spillDirectory->path; },
+      [&](uint64_t) {},
+      "0.0.0",
+      1000,
+      false,
+      0,
+      executor_.get(),
+      5,
+      10,
+      0,
+      0,
+      0,
+      0,
+      0,
+      100, //  testSpillPct
+      "none");
+  const std::shared_ptr<memory::MemoryPool> fuzzerPool =
+      memory::memoryManager()->addLeafPool("VectorFuzzer");
+  auto type = ROW({"c0", "c1"}, {BIGINT(), BIGINT()});
+  std::vector<CompareFlags> sortCompareFlags = {
+      {true, true, false, CompareFlags::NullHandlingMode::kNullAsValue}};
+  std::vector<column_index_t> sortIndx = {0};
+  auto sortBuffer = std::make_unique<SortBufferMergePath>(
+      type,
+      sortIndx,
+      sortCompareFlags,
+      pool_.get(),
+      &nonReclaimableSection_,
+      &queryConfig,
+      nullptr,
+      nullptr,
+      executor_);
+  auto exec = std::make_shared<folly::CPUThreadPoolExecutor>(
+      std::thread::hardware_concurrency());
+  const int numRows = 2'000'000;
+  // split row generation over multiple threads
+  std::vector<folly::Future<RowVectorPtr>> futures;
+  for (int i = 0; i < std::thread::hardware_concurrency(); i++) {
+    auto chunkSize = numRows / std::thread::hardware_concurrency();
+    auto chunkStart = i * chunkSize;
+    futures.push_back(folly::via(exec.get(), [this, chunkSize, chunkStart]() {
+      std::random_device rd;
+      std::mt19937 g(rd());
+      std::vector<uint64_t> c0(chunkSize);
+      std::vector<uint64_t> c1(chunkSize);
+      for (int j = 0; j < chunkSize; j++) {
+        c0[j] = chunkStart + j;
+      }
+      std::shuffle(c0.begin(), c0.end(), g);
+      for (int j = 0; j < chunkSize; j++) {
+        c1[j] = c0[j] % 7;
+      }

+      return makeRowVector(
+          {makeFlatVector<uint64_t>(c0), makeFlatVector<uint64_t>(c1)});
+    }));
+  }
+  auto inputVectors = folly::collectAll(futures).get();
+  std::random_device rd;
+  std::mt19937 g(rd());
+  std::shuffle(inputVectors.begin(), inputVectors.end(), g);
+  for (auto inputVec : inputVectors) {
+    sortBuffer->addInput(inputVec.value());
+  }
+  sortBuffer->noMoreInput();
+  auto baseResult = BaseVector::create(type, 0, pool_.get());
+  auto* result = baseResult->as<RowVector>();
+  while (true) {
+    auto outputVec = sortBuffer->getOutput(10 << 10);
+    if (outputVec == nullptr) {
+      break;
+    }
+    result->append(outputVec.get());
+  }
+  ASSERT_EQ(result->size(), numRows);
+  // verify sorted column output is consistent
+  auto c1Vector = result->childAt(0);
+  auto* c1FlatVector = c1Vector->asFlatVector<int64_t>();
+  for (int i = 1; i < result->size(); i++) {
+    EXPECT_GE(c1FlatVector->valueAt(i), c1FlatVector->valueAt(i - 1));
+  }
+}
