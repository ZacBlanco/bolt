+
+  // When performing OrderBy operations, we transfer ownership of rows into new
+  // containers. Once transferred, we should remove the rows from the old
+  // containers so they are not freed when the container is released.
+  // call markRowsTransferred to remove references to all rows in this container
+  // spilling and de-allocation will no longer occur for this container, essentially
+  // making it empty.
+  void markRowsTransferred() {
+    rows_->rows_.clear();
