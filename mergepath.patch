+namespace bytedance::bolt::exec {
+using bytedance::bolt::memory::MemoryPool;
+
+std::tuple<std::unique_ptr<std::ofstream>, std::unique_ptr<OutputStream>>
+SpilledBlockFile::createOutputStream() {
+  auto outfile = std::make_unique<std::ofstream>(filePath_);
+  auto outputStream = std::make_unique<OStreamOutputStream>(outfile.get());
+  return std::make_tuple(std::move(outfile), std::move(outputStream));
+}
+
+std::unique_ptr<ByteInputStream> SpilledBlockFile::createInputStream() {
+  auto readFile = std::make_unique<LocalReadFile>(filePath_);
+  constexpr uint64_t kBufferSize = 64 * 1024 * 1024; // 64 MiB
+  auto stream = std::make_unique<bytedance::bolt::common::FileInputStream>(
+      std::move(readFile), kBufferSize, pool_);
+  return stream;
+}
+
+PinnedRowContainer::PinnedRowContainer(
+    std::shared_ptr<LoadedRowContainer> rows,
+    RowContainerRef* parent)
+    : rows_(std::move(rows)), parent_(parent) {}
+
+PinnedRowContainer::~PinnedRowContainer() {
+  if (auto* parentRef = parent_.value()) {
+    // must lock parent since we may modify the in memory/LRU state
+    std::lock_guard guard(parentRef->lock_);
+    auto pinCount = parentRef->pinCount_.fetch_sub(1);
+    // if the pin count is 0, then we can add the container back to the LRU
+    // list for potential eviction.
+    if (pinCount == 1) {
+      if (auto* parentContainer = parentRef->parent_.value()) {
+        parentContainer->addToLRU(parentRef->id_);
+      }
+    }
+  }
+}
+
+static uint64_t rowContainerMemoryUsage(
+    const RowContainer* container,
+    const std::vector<char*>& rows) {
+  return container->estimateRowSize().value_or(0) * rows.size();
+}
+
+SpillableRowContainer::~SpillableRowContainer() {
+  if (auto* parentRef = container_->parent_.value()) {
+    parentRef->releaseContainer(container_);
+  }
+}
+
+std::shared_ptr<PinnedRowContainer> SpillableRowContainer::pin() {
+  return container_->pin();
+}
+
+uint64_t SpillableRowContainer::numRows() {
+  return container_->numRows();
+}
+
+// returns - (sortedColumnTypes, nonSortedColumnTypes, sortedSpillRowType,
+// projectionMapping)
+//
+// sortedColumnTypes - The types of the columns that are sorted (in order)
+// nonSortedColumnTypes - The types of the columns that are not sorted (in
+//                        order).
+// sortedSpillRowType - The row type of the spilled rows.
+// projectionMapping - The mapping of the columns in the spilled rows to the
+// columns in the input row.
+//                     The index in this vector represents the column index in
+//                     the spilled row. The value in this vector represents the
+//                     column index in the input row. e.g. projectionMapping[0]
+//                     represents the column in the spilled row at index 0 is
+//                     the column in the input row at index
+//                     projectionMapping[0].
+std::tuple<
+    std::vector<TypePtr>,
+    std::vector<TypePtr>,
+    RowTypePtr,
+    std::vector<size_t>>
+calculateTypes(
+    const std::vector<column_index_t>& sortColumnIndices,
+    const std::vector<CompareFlags>& sortCompareFlags,
+    const RowTypePtr& inputType) {
+  std::vector<TypePtr> sortedColumnTypes;
+  std::vector<TypePtr> nonSortedColumnTypes;
+  std::vector<std::string> sortedSpillColumnNames;
+  std::vector<TypePtr> sortedSpillColumnTypes;
+  std::vector<size_t> projectionMapping;
+  sortedColumnTypes.reserve(sortColumnIndices.size());
+  nonSortedColumnTypes.reserve(inputType->size() - sortColumnIndices.size());
+  sortedSpillColumnNames.reserve(inputType->size());
+  sortedSpillColumnTypes.reserve(inputType->size());
+  std::unordered_set<column_index_t> sortedChannelSet;
+  // Sorted key columns.
+  for (column_index_t i = 0; i < sortColumnIndices.size(); ++i) {
+    projectionMapping.push_back(sortColumnIndices.at(i));
+    sortedColumnTypes.emplace_back(inputType->childAt(sortColumnIndices.at(i)));
+    sortedSpillColumnTypes.emplace_back(
+        inputType->childAt(sortColumnIndices.at(i)));
+    sortedSpillColumnNames.emplace_back(
+        inputType->nameOf(sortColumnIndices.at(i)));
+    sortedChannelSet.emplace(sortColumnIndices.at(i));
+  }
+  // Non-sorted key columns.
+  for (column_index_t i = 0, nonSortedIndex = sortCompareFlags.size();
+       i < inputType->size();
+       ++i) {
+    if (sortedChannelSet.count(i) != 0) {
+      continue;
+    }
+    projectionMapping.push_back(i);
+    nonSortedColumnTypes.emplace_back(inputType->childAt(i));
+    sortedSpillColumnTypes.emplace_back(inputType->childAt(i));
+    sortedSpillColumnNames.emplace_back(inputType->nameOf(i));
+  }
+  return std::make_tuple(
+      sortedColumnTypes,
+      nonSortedColumnTypes,
+      std::make_shared<RowType>(
+          std::move(sortedSpillColumnNames), std::move(sortedSpillColumnTypes)),
+      projectionMapping);
+}
+
+std::vector<char*> getAllRows(RowContainer* container) {
+  int64_t totalRows = container->numRows();
+  std::vector<char*> allRows(totalRows);
+  RowContainerIterator iter;
+  iter.reset();
+  int32_t rowsRetrieved = container->listRows(&iter, totalRows, allRows.data());
+  allRows.resize(rowsRetrieved);
+
+  return allRows;
+}
+
+OrderByRowContainer::OrderByRowContainer(
+    const std::vector<column_index_t>& sortColumnIndices,
+    const std::vector<CompareFlags>& sortCompareFlags,
+    const RowTypePtr& inputType,
+    MemoryPool* pool,
+    const common::SpillConfig* spillConfig,
+    uint64_t maxMemory)
+    : pool_(pool),
+      maxMemory_(0), // TODO change this to actual maxMemory when
+                     // SortBufferMergePath supports spilling
+      inputType_(inputType),
+      spillConfig_(spillConfig),
+      evictions_(0) {
+  auto
+      [sortedColumnTypes,
+       nonSortedColumnTypes,
+       sortedSpillRowType,
+       projectionMapping] =
+          calculateTypes(sortColumnIndices, sortCompareFlags, inputType);
+  sortedColumnTypes_ = sortedColumnTypes;
+  nonSortedColumnTypes_ = nonSortedColumnTypes;
+  spillType_ = sortedSpillRowType;
+  projectionMapping_ = projectionMapping;
+  spillPath_ =
+      spillConfig_ == nullptr ? "/tmp" : spillConfig_->getSpillDirPathCb();
+  rowContainer_ = emptyRowContainer();
+}
+
+std::vector<char*> OrderByRowContainer::addVectorToContainer(
+    const VectorPtr& input,
+    RowContainer* container,
+    std::mutex& rowContainerLock,
+    const std::vector<size_t>& projectionMapping) {
+  std::vector<char*> rows(input->size());
+  SelectivityVector allRows(input->size());
+  std::lock_guard containerLock(rowContainerLock);
+  for (int row = 0; row < input->size(); ++row) {
+    rows[row] = container->newRow();
+  }
+  auto* inputRow = input->as<RowVector>();
+  for (int i = 0; i < projectionMapping.size(); ++i) {
+    auto outputChannel = i;
+    auto inputChannel = projectionMapping[i];
+    DecodedVector decoded(*inputRow->childAt(inputChannel), allRows);
+    auto kind = inputRow->childAt(inputChannel)->type()->kind();
+    BOLT_DYNAMIC_TYPE_DISPATCH(
+        container->storeColumn,
+        kind,
+        decoded,
+        input->size(),
+        rows,
+        static_cast<size_t>(outputChannel));
+  }
+  return rows;
+}
+std::shared_ptr<SpillableRowContainer> OrderByRowContainer::addVector(
+    const VectorPtr& input) {
+  std::vector<char*> rows;
+  rows = OrderByRowContainer::addVectorToContainer(
+      input, rowContainer_.get(), rowContainerLock_, projectionMapping_);
+  return this->addToRowContainer(std::move(rows));
+}
+
+std::shared_ptr<SpillableRowContainer> OrderByRowContainer::addVectors(
+    const std::vector<VectorPtr>& vectors) {
+  auto totalRows = 0;
+  std::vector<std::vector<char*>> rows(vectors.size());
+  for (auto& vector : vectors) {
+    totalRows += vector->size();
+    rows.push_back(addVectorToContainer(
+        vector, rowContainer_.get(), rowContainerLock_, projectionMapping_));
+  }
+  std::vector<char*> allRows;
+  allRows.reserve(totalRows);
+  for (auto& row : rows) {
+    allRows.insert(allRows.end(), row.begin(), row.end());
+  }
+  return this->addToRowContainer(std::move(allRows));
+}
+
+OrderByRowContainer::~OrderByRowContainer() {
+  for (auto& [id, ref] : containers_) {
+    if (ref != nullptr) {
+      ref->parent_ = {};
+    }
+  }
+}
+
+std::string OrderByRowContainer::dumpLru() {
+  std::stringstream ss;
+  ss << "HEAD -> ";
+  auto container = head_.lock();
+  while (container) {
+    ss << container->id_ << " ";
+    container = container->lruNext_.lock();
+  }
+  ss << " <- TAIL";
+  return ss.str();
+}
+
+std::shared_ptr<SpillableRowContainer> OrderByRowContainer::addToRowContainer(
+    std::vector<char*>&& allRows) {
+  uint32_t id = idCounter_.fetch_add(1);
+  auto container = std::make_shared<RowContainerRef>(id, allRows.size(), this);
+  uint64_t memoryUsage = rowContainerMemoryUsage(rowContainer_.get(), allRows);
+  container->rows_ = std::make_unique<LoadedRowContainer>(
+      rowContainer_.get(), std::move(allRows));
+  {
+    std::lock_guard lock(lock_);
+    containers_.emplace(container->id_, container);
+    memoryCounter_.fetch_add(memoryUsage);
+    addToLRU(container->id_);
+  }
+  checkMemoryUsage();
+  return std::make_shared<SpillableRowContainer>(container);
+}
+
+std::unique_ptr<RowContainer> OrderByRowContainer::emptyRowContainer() {
+  return std::make_unique<RowContainer>(
+      sortedColumnTypes_, nonSortedColumnTypes_, pool_);
+}
+
+// Removes a container from tracking. Removes from the LRU list. de-allocates
+// any in-memory row container decrements memory counter.
+void OrderByRowContainer::releaseContainer(
+    const std::shared_ptr<RowContainerRef>& container) {
+  std::lock_guard lock(lock_);
+
+  auto it = containers_.find(container->id_);
+  if (it != containers_.end()) {
+    auto rowContainer = it->second;
+    removeFromLRU(container->id_);
+    if (container->rows_.has_value()) {
+      memoryCounter_.fetch_sub(rowContainerMemoryUsage(
+          container->rows_.value()->container_,
+          container->rows_.value()->rows_));
+    }
+    container->rows_.reset();
+    containers_.erase(it);
+  }
+}
+
+// requires that the reclaimLock_ already be held. Decrements the memory counter
+// by the size of all containers removed.
+// It is important that the locking order is respected. To prevent deadlock the
+// lock_ can only be acquired after a RowContainerRef's lock is acquired.
+uint64_t OrderByRowContainer::reclaimMemory(uint64_t requiredBytes) {
+  uint64_t reclaimed = 0;
+  auto current = tail_;
+  while (reclaimed < requiredBytes) {
+    if (auto ptr = current.lock()) {
+      std::lock_guard containerLock(ptr->lock_);
+      std::lock_guard lock(lock_);
+      if (ptr->pinCount_.load() > 0) {
+        // check if while locking this container was pinned
+        // In this case, the container was likely pinned while
+        // trying to acquire the lock. Use the new tail pointer
+        // to try the next container.
+        current = tail_;
+        continue;
+      }
+
+      removeFromLRU(ptr->id_);
+      evictions_++;
+      if (ptr->rows_.has_value()) {
+        auto reclaimedMem = rowContainerMemoryUsage(
+            ptr->rows_.value()->container_, ptr->rows_.value()->rows_);
+        ptr->spillToDisk();
+        ptr->rows_.reset();
+        memoryCounter_.fetch_sub(reclaimedMem);
+        reclaimed += reclaimedMem;
+      }
+      current = tail_;
+      if (current.expired()) {
+        break;
+      }
+    } else {
+      break;
+    }
+  }
+
+  return reclaimed;
+}
+
+// Adds to the head_ of the list.
+void OrderByRowContainer::addToLRU(uint64_t id) {
+  std::lock_guard lock(lock_);
+  auto it = containers_.find(id);
+  if (it == containers_.end()) {
+    return;
+  }
+  const std::shared_ptr<RowContainerRef>& container = it->second;
+  // if we're adding to the LRU list, ensure that both existing pointers are
+  // null
+  BOLT_CHECK(
+      container->lruPrev_.expired(),
+      "container {} already in LRU. prev: {}, next {}",
+      id,
+      container->lruPrev_.use_count(),
+      container->lruNext_.use_count());
+  BOLT_CHECK(
+      container->lruNext_.expired(),
+      "container {} already in LRU. prev: {}, next {}",
+      id,
+      container->lruPrev_.use_count(),
+      container->lruNext_.use_count());
+  if (head_.expired()) {
+    BOLT_CHECK(container->lruPrev_.expired()); // should not occur
+    head_ = tail_ = container;
+    container->lruPrev_.reset();
+    container->lruNext_.reset();
+  } else {
+    // adding to the head of the list, set the current value as the head.
+    container->lruNext_ = head_;
+    if (auto head = head_.lock()) {
+      head->lruPrev_ = container;
+    }
+    head_ = container;
+  }
+}
+
+void OrderByRowContainer::removeFromLRU(uint64_t id) {
+  std::lock_guard lock(lock_);
+  auto it = containers_.find(id);
+  if (it == containers_.end()) {
+    return;
+  }
+  const std::shared_ptr<RowContainerRef>& container = it->second;
+  if (container == nullptr) {
+    return;
+  }
+  if (auto head = head_.lock()) {
+    if (container == head) {
+      head_ = container->lruNext_;
+    }
+  }
+  if (auto tail = tail_.lock()) {
+    if (container == tail) {
+      tail_ = container->lruPrev_;
+    }
+  }
+
+  if (auto prev = container->lruPrev_.lock()) {
+    prev->lruNext_ = container->lruNext_;
+  }
+  if (auto next = container->lruNext_.lock()) {
+    next->lruPrev_ = container->lruPrev_;
+  }
+
+  container->lruPrev_.reset();
+  container->lruNext_.reset();
+}
+
+void OrderByRowContainer::checkMemoryUsage() {
+  if (maxMemory_ == 0) {
+    return;
+  }
+  BOLT_FAIL("Should not be reclaiming memory: maxMemory = {}", maxMemory_);
+  std::lock_guard lock(reclaimLock_);
+  uint64_t usedMemory = rowContainer_->usedBytes();
+  if (usedMemory > maxMemory_) {
+    reclaimMemory(usedMemory - maxMemory_);
+  }
+}
+
+std::unique_ptr<RowContainer> OrderByRowContainer::release() {
+  std::lock_guard guard(lock_);
+  containers_.clear();
+  std::unique_ptr<RowContainer> rowContainer = std::move(rowContainer_);
+  return rowContainer;
+}
+
+RowContainerRef::RowContainerRef(
+    uint32_t id,
+    uint64_t numRows,
+    OrderByRowContainer* parent)
+    : id_(id), numRows_(numRows), parent_(parent) {
+  spillMemoryPool_ = parent->pool_;
+  spillRowType_ = parent->spillType_;
+}
+
+RowContainerRef::~RowContainerRef() {
+  // remove from LRU to prevent dangling pointers in the LRU list
+  if (auto parent = parent_.value()) {
+    parent->removeFromLRU(id_);
+  }
+}
+
+std::shared_ptr<PinnedRowContainer> RowContainerRef::pin() {
+  {
+    std::lock_guard lock(lock_);
+    auto previousPinCount = pinCount_.fetch_add(1);
+    // if the previous count was 0, then we need to load the rows and remove
+    // from the LRU list.
+    if (previousPinCount == 0) {
+      // first, remove from LRU list and load rows if necessary.
+      if (auto* parent = parent_.value()) {
+        parent->removeFromLRU(id_);
+      }
+      // load rows if required. Make sure afterward we are still below the
+      // memory threshold.
+      if (!rows_.has_value()) {
+        loadFromDisk();
+      }
+    }
+  }
+  if (auto* parent = parent_.value()) {
+    parent->checkMemoryUsage();
+  }
+  auto pinned = std::make_shared<PinnedRowContainer>(rows_.value(), this);
+  // existingPin_ = pinned;
+  return pinned;
+}
+
+std::string RowContainerRef::filePath() const {
+  if (auto* parent = parent_.value()) {
+    return parent->spillPath_ + "/" + std::to_string(id_);
+  }
+  return "/tmp/orderby_spill_" + std::to_string(id_);
+}
+
+void RowContainerRef::spillToDisk() {
+  BOLT_FAIL("Spilling is not supported");
+  if (!rows_.has_value()) {
+    return; // no data to spill
+  }
+  std::lock_guard lock(lock_);
+
+  // if the current container is dirty, or we have not spilled yet, perform the
+  // spill. Otherwise we can just clear the memory
+  if (!spillFile_.has_value()) {
+    auto rowContainer = rows_.value();
+    auto& allRows = rowContainer->rows_;
+    // Filter out rows which have been nulled.
+    auto new_end =
+        std::remove_if(allRows.begin(), allRows.end(), [](const char* n) {
+          return n == nullptr;
+        });
+    allRows.erase(new_end, allRows.end());
+    auto serialized = BaseVector::create<FlatVector<StringView>>(
+        VARBINARY(), allRows.size(), spillMemoryPool_);
+    rowContainer->container_->extractSerializedRows(
+        folly::Range<char**>(allRows.data(), allRows.size()), serialized);
+    auto serde = serializer::spark::UnsafeRowVectorSerde();
+    auto serializer = serde.createBatchSerializer(spillMemoryPool_);
+    spillFile_ = SpilledBlockFile(filePath(), spillMemoryPool_);
+    auto [outfile, outputStream] = spillFile_.value().createOutputStream();
+    auto rowVector = std::shared_ptr<RowVector>(new RowVector(
+        spillMemoryPool_,
+        ROW({"data"}, {VARBINARY()}),
+        BufferPtr(nullptr),
+        serialized->size(),
+        {serialized}));
+    serializer->serialize(rowVector, outputStream.get());
+    rowContainer->container_->eraseRows(
+        folly::Range(allRows.data(), allRows.data() + allRows.size()));
+  }
+
+  // Clear the in-memory data
+  rows_.reset();
+}
+
+// Load a block from disk. rows_ is guaranteed to be populated after this method
+// is called. It is not added to the parent LRU list yet though.
+void RowContainerRef::loadFromDisk() {
+  BOLT_FAIL("spilling is not supported");
+  std::lock_guard lock(lock_);
+
+  if (!spillFile_.has_value() || rows_.has_value()) {
+    if (!rows_.has_value()) {
+      // rows_ must be populated after this call, but there is no spill file on
+      // disk. In this case, it's likely that the container was never written to
+      // before. Just create a new empty one.
+      if (auto refParent = parent_.value()) {
+        std::vector<char*> tmpRows(0);
+        rows_ = std::make_shared<LoadedRowContainer>(
+            refParent->rowContainer_.get(), std::move(tmpRows));
+      }
+    }
+    return;
+  }
+
+  // Read from spilled file, deserialize rows
+  auto inputStream = spillFile_.value().createInputStream();
+  auto serde = serializer::spark::UnsafeRowVectorSerde();
+  RowTypePtr type = ROW({"data"}, {VARBINARY()});
+  RowVectorPtr result = RowVector::createEmpty(type, spillMemoryPool_);
+  serde.deserialize(
+      inputStream.get(), spillMemoryPool_, type, &result, nullptr);
+  BOLT_CHECK(parent_.has_value(), "parent_ must be non-null");
+
+  auto* serializedRows = result->childAt(0)->asFlatVector<StringView>();
+  std::vector<char*> rows(result->size());
+  auto& rowContainer = parent_.value()->rowContainer_;
+  for (auto i = 0; i < result->size(); ++i) {
+    char* row = rows[i] = rowContainer->newRow();
+    rowContainer->storeSerializedRow(*serializedRows, i, row);
+  }
+  rows_ =
+      std::make_shared<LoadedRowContainer>(rowContainer.get(), std::move(rows));
+  parent_.value()->memoryCounter_.fetch_add(
+      rowContainerMemoryUsage(rows_.value()->container_, rows_.value()->rows_));
+}
