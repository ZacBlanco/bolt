+OrderedContainer::OrderedContainer(
+    uint64_t totalRecords,
+    std::vector<std::shared_ptr<SpillableRowContainer>>&& containers,
+    std::vector<uint64_t>&& indexes)
+    : sortedContainers_(std::move(containers)),
+      indexes_(std::move(indexes)),
+      totalRecords_(totalRecords) {}
+
+std::pair<uint64_t, uint64_t> OrderedContainer::getContainerIdx(
+    uint64_t idx,
+    const std::vector<uint64_t>& indexes) {
+  uint64_t lowIdx = 0;
+  uint64_t maxIdx = indexes.size() - 1;
+  while (true) {
+    uint64_t midIdx = lowIdx + ((maxIdx - lowIdx) / 2);
+    if (idx >= indexes[midIdx]) {
+      if ((midIdx + 1 < indexes.size() && idx < indexes[midIdx + 1]) ||
+          midIdx + 1 == indexes.size()) {
+        return std::pair(midIdx, idx - indexes[midIdx]);
+      }
+      lowIdx = midIdx + 1;
+    } else {
+      maxIdx = midIdx - 1;
+    }
+    if (maxIdx == lowIdx) {
+      return std::pair(maxIdx, idx - indexes[maxIdx]);
+    }
+  }
+}
+std::pair<uint64_t, uint64_t> OrderedContainer::getContainerIdx(
+    uint64_t idx) const {
+  return getContainerIdx(idx, indexes_);
+}
+
+std::shared_ptr<OrderedContainer> OrderedContainer::newContainer(
+    std::shared_ptr<SpillableRowContainer> container) {
+  auto records = container->numRows();
+  return std::make_shared<OrderedContainer>(
+      records, std::vector{std::move(container)}, std::vector<uint64_t>{0});
+}
+
+std::shared_ptr<OrderedContainer> OrderedContainer::merge(
+    const std::vector<std::shared_ptr<OrderedContainer>>& containers) {
+  // compute new total_records_ for the merged container.
+  std::uint64_t newTotalRecords = 0;
+  for (const auto& container : containers) {
+    newTotalRecords += container->totalRecords_;
+  }
+  // compute new indexes_ for the merged container.
+  // the first container maintains it's indexes array. The subsequent indexes
+  // are concatenated on to the new index array, but their values are offset
+  // by the total_records_ of the previous containers.
+  std::vector<uint64_t> newIndexes = containers[0]->indexes_;
+  uint64_t currentTotalRecords = containers[0]->totalRecords_;
+  // skip first container in loop
+  for (const auto& container : containers) {
+    if (container == containers[0]) {
+      continue;
+    }
+    // transform all indexes in container by adding the total_records_ of the
+    // previous container.
+    std::vector<uint64_t> tmpIndexes(container->indexes_.size());
+    std::transform(
+        container->indexes_.begin(),
+        container->indexes_.end(),
+        tmpIndexes.begin(),
+        [currentTotalRecords](uint64_t idx) {
+          return idx + currentTotalRecords;
+        });
+    newIndexes.insert(newIndexes.end(), tmpIndexes.begin(), tmpIndexes.end());
+    currentTotalRecords += container->totalRecords_;
+  }
+
+  // concatenate all internal containers
+  std::vector<std::shared_ptr<SpillableRowContainer>> newSortedContainers;
+  for (const auto& container : containers) {
+    newSortedContainers.insert(
+        newSortedContainers.end(),
+        container->sortedContainers_.begin(),
+        container->sortedContainers_.end());
+  }
+  return std::make_shared<OrderedContainer>(
+      newTotalRecords, std::move(newSortedContainers), std::move(newIndexes));
+}
+
+std::string OrderedContainer::toString() const {
+  // create a comma-separated string from ordered container indexes_
+  std::string containerIdxStr = fmt::format("{}", fmt::join(indexes_, ","));
+  std::string containerRowCounts = fmt::format(
+      "{}",
+      fmt::join(
+          [&]() {
+            std::vector<std::string> rowCounts;
+            rowCounts.reserve(sortedContainers_.size());
+            std::transform(
+                sortedContainers_.begin(),
+                sortedContainers_.end(),
+                std::back_inserter(rowCounts),
+                [](const std::shared_ptr<SpillableRowContainer>& container) {
+                  return fmt::format("{}", container->numRows());
+                });
+            return rowCounts;
+          }(),
+          ","));
+  return fmt::format(
+      "OrderedContainer(totalRecords={}, \nindexes={}, \nrowCounts={})",
+      totalRecords_,
+      containerIdxStr,
+      containerRowCounts);
+}
+
+struct Boundary {
+  size_t begin = 0;
+  size_t end = 0;
+};
+
+template <class T>
+static T alignValue(T n, T val) {
+  return ((n + (val - 1)) / val) * val;
+}
+
+static size_t compuateBoundaryDelta(
+    const size_t& total_remaining,
+    const size_t& k,
+    const Boundary& run_boundary) {
+  const auto runRemaining = run_boundary.end - run_boundary.begin;
+  return std::min(alignValue(total_remaining, k) / k, runRemaining);
+}
+
+// This implements the K-way merge from the DuckDB blog post, but
+// just for the specific case of 2 vectors.
+// Arguments:
+//   - a: input ordered container
+//   - b: 2nd input ordered container.
+//   - threadIdx: 0-indexed identifier of the thread computing this partition
+//   - totalPartitions: the total number of partitions that will be computed
+//   (this method computes just one)
+//   - op: reference to parent
+//   - lastPartition: the previous partition's computed values
+static std::pair<uint64_t, uint64_t> calculatePartitionPoint_DDB(
+    const std::shared_ptr<OrderedContainer>& a,
+    const std::shared_ptr<OrderedContainer>& b,
+    const uint32_t threadIdx,
+    const uint32_t totalPartitions,
+    const SortBufferMergePath* op,
+    const std::pair<uint64_t, uint64_t>& lastPartition) {
+  auto partitionSize = (a->totalRecords_ + b->totalRecords_) / totalPartitions;
+  size_t totalRemaining = (threadIdx + 1) * partitionSize;
+  std::vector<std::shared_ptr<OrderedContainer>> runs = {a, b};
+  std::vector<size_t> activeRunIdxs = {0, 1};
+  totalRemaining -= lastPartition.first; // index of a's last boundary
+  totalRemaining -= lastPartition.second; // index of b's last boundary
+  std::vector<Boundary> runBoundaries = {
+      {.begin = lastPartition.first, .end = a->totalRecords_},
+      {.begin = lastPartition.second, .end = b->totalRecords_}};
+  std::shared_ptr<PinnedRowContainer> minContainerPinned;
+  uint64_t minContainerLastInnerContainerIdx;
+
+  // while we haven't assigned all records in this partition
+  while (totalRemaining != 0) {
+    const size_t k = runs.size();
+    auto minRunIdx = activeRunIdxs[0];
+    // the minimum amount to move up the pointer for each run
+    auto minDelta =
+        compuateBoundaryDelta(totalRemaining, k, runBoundaries[minRunIdx]);
+    size_t minRowValueIdx = runBoundaries[minRunIdx].begin + minDelta - 1;
+    for (size_t i = 1; i < activeRunIdxs.size(); i++) {
+      const auto& activeRunIdx = activeRunIdxs[i];
+      const auto& runBoundary = runBoundaries[activeRunIdx];
+      const auto runDelta =
+          compuateBoundaryDelta(totalRemaining, k, runBoundary);
+      auto runValueIdx = runBoundary.begin + runDelta - 1;
+      uint64_t bContainerIdx = 0;
+      std::shared_ptr<PinnedRowContainer> bContainer = nullptr;
+      auto less = compareLessGlobal(
+          runValueIdx,
+          runs[activeRunIdx],
+          bContainerIdx,
+          bContainer,
+          minRowValueIdx,
+          runs[minRunIdx],
+          minContainerLastInnerContainerIdx,
+          minContainerPinned,
+          op);
+      if (less) {
+        minRunIdx = activeRunIdx;
+        minDelta = runDelta;
+        minRowValueIdx = runValueIdx;
+        minContainerLastInnerContainerIdx = bContainerIdx;
+      }
+    }
+
+    auto& minRunBoundary = runBoundaries[minRunIdx];
+    minRunBoundary.begin += minDelta;
+
+    if (minRunBoundary.begin == minRunBoundary.end) {
+      activeRunIdxs.erase(std::ranges::find(activeRunIdxs, minRunIdx));
+    }
+
+    BOLT_CHECK(minDelta <= totalRemaining);
+    totalRemaining -= minDelta;
+  }
+
+  // End of boundary is meaningless now, just set equal to begin so there's no
+  // confusion
+  for (auto& runBoundary : runBoundaries) {
+    runBoundary.end = runBoundary.begin;
+  }
+  return {runBoundaries[0].end, runBoundaries[1].end};
+}
+
+std::shared_ptr<OrderedContainer> SortWork::merge() {
+  // absolute indexes within entire sorted container
+  uint32_t aCurrent = aPart.minIdx;
+  uint32_t bCurrent = bPart.minIdx;
+  uint64_t outputRows =
+      (aPart.maxIdx - aPart.minIdx) + (bPart.maxIdx - bPart.minIdx);
+  // current result container
+  RowContainer* currentResultContainer = op->rowContainer_->rowContainer();
+  std::vector<char*> currentResultContainerRows;
+  uint64_t currentRowCount = 0;
+  std::vector<std::shared_ptr<SpillableRowContainer>> results;
+  std::vector<uint64_t> indexes;
+  // first container always starts at 0
+  indexes.push_back(0);
+  // *_idx is the index of the container in the sorted_containers_ vector
+  // *_compare_idx is the relative index of the element in the container which
+  // should be compared.
+  auto [aIdx, aCompareIdx] = a->getContainerIdx(aCurrent);
+  auto [bIdx, bCompareIdx] = b->getContainerIdx(bCurrent);
+  // pin the containers if necessary
+  auto aContainer = a->sortedContainers_[aIdx]->pin();
+  auto bContainer = b->sortedContainers_[bIdx]->pin();
+
+  while (aCurrent < aPart.maxIdx && bCurrent < bPart.maxIdx) {
+    // check if a new result container needs to be created.
+    if (currentResultContainerRows.size() *
+            currentResultContainer->fixedRowSize() >=
+        op->targetContainerMemory_) {
+      uint64_t lastRowsCount = currentResultContainerRows.size();
+      std::shared_ptr<SpillableRowContainer> resultContainer =
+          op->rowContainer_->addToRowContainer(
+              std::move(currentResultContainerRows));
+      results.push_back(resultContainer);
+      indexes.push_back(currentRowCount);
+      currentResultContainer = op->rowContainer_->rowContainer();
+      currentResultContainerRows.clear();
+      currentResultContainerRows.reserve(lastRowsCount);
+    }
+
+    // *_compare_idx should be less than the size of the current pinned
+    // container. otherwise, pin a new container, increment a_idx and reset
+    // a_compare_idx to 0.
+    if (aIdx < a->indexes_.size() - 1 && aCurrent >= a->indexes_[aIdx + 1]) {
+      aIdx++;
+      aCompareIdx = 0;
+      aContainer = a->sortedContainers_[aIdx]->pin();
+    }
+    if (bIdx < b->indexes_.size() - 1 && bCurrent >= b->indexes_[bIdx + 1]) {
+      bIdx++;
+      bCompareIdx = 0;
+      bContainer = b->sortedContainers_[bIdx]->pin();
+    }
+    if (compareLess(aCompareIdx, aContainer, bCompareIdx, bContainer, op)) {
+      auto& tmpRows = aContainer->getRows();
+      BOLT_CHECK_NE(
+          tmpRows[aCompareIdx],
+          nullptr,
+          "nullptr at global index {} in container {} at containerIdx {}",
+          aCurrent,
+          aIdx,
+          aCompareIdx);
+      currentResultContainerRows.push_back(tmpRows[aCompareIdx]);
+      aCurrent++;
+      aCompareIdx++;
+    } else {
+      auto& tmpRows = bContainer->getRows();
+      BOLT_CHECK_NE(
+          tmpRows[bCompareIdx],
+          nullptr,
+          "nullptr at global index {} in container {} at containerIdx {}",
+          bCurrent,
+          bIdx,
+          bCompareIdx);
+      currentResultContainerRows.push_back(tmpRows[bCompareIdx]);
+      bCurrent++;
+      bCompareIdx++;
+    }
+    currentRowCount++;
+  }
+  // there may be rows left in a or b. Copy the remaining rows from the
+  // current idx in the remaining vector into the final result containers.
+  uint64_t currentIdx;
+  uint64_t currentContainerIdx;
+  uint64_t currentCompareIdx;
+  uint64_t maxIdx;
+  std::shared_ptr<OrderedContainer> remainingRecords;
+  std::shared_ptr<PinnedRowContainer> remainingPinned;
+  if (aCurrent < aPart.maxIdx) {
+    currentIdx = aCurrent;
+    currentContainerIdx = aIdx;
+    currentCompareIdx = aCompareIdx;
+    maxIdx = aPart.maxIdx;
+    remainingRecords = a;
+    remainingPinned = aContainer;
+  } else {
+    currentIdx = bCurrent;
+    currentContainerIdx = bIdx;
+    currentCompareIdx = bCompareIdx;
+    maxIdx = bPart.maxIdx;
+    remainingRecords = b;
+    remainingPinned = bContainer;
+  }
+  while (currentIdx < maxIdx) {
+    // create a new result container if required
+    if (currentResultContainerRows.size() *
+            currentResultContainer->fixedRowSize() >=
+        op->targetContainerMemory_) {
+      size_t lastRowCount = currentResultContainerRows.size();
+      std::shared_ptr<SpillableRowContainer> resultContainer =
+          op->rowContainer_->addToRowContainer(
+              std::move(currentResultContainerRows));
+      results.push_back(resultContainer);
+      indexes.push_back(currentRowCount);
+      currentResultContainer = op->rowContainer_->rowContainer();
+      currentResultContainerRows.clear();
+      currentResultContainerRows.reserve(lastRowCount);
+    }
+    // pin a new container if required
+    if (currentContainerIdx < remainingRecords->indexes_.size() - 1 &&
+        currentIdx >= remainingRecords->indexes_[currentContainerIdx + 1]) {
+      currentContainerIdx++;
+      currentCompareIdx = 0;
+      remainingPinned =
+          remainingRecords->sortedContainers_[currentContainerIdx]->pin();
+    }
+    BOLT_CHECK(currentCompareIdx < remainingPinned->getRows().size());
+    auto& tmpRows = remainingPinned->getRows();
+    BOLT_CHECK_NE(
+        tmpRows[currentCompareIdx],
+        nullptr,
+        "nullptr at global index {} in container {} at containerIdx {}",
+        currentIdx,
+        currentContainerIdx,
+        currentCompareIdx);
+    currentResultContainerRows.push_back(tmpRows[currentCompareIdx]);
+    currentIdx++;
+    currentCompareIdx++;
+    currentRowCount++;
+  }
+  if (currentResultContainerRows.size() > 0) {
+    std::shared_ptr<SpillableRowContainer> resultContainer =
+        op->rowContainer_->addToRowContainer(
+            std::move(currentResultContainerRows));
+    results.push_back(resultContainer);
+  }
+#ifndef NDEBUG
+  BOLT_CHECK_EQ(
+      outputRows,
+      currentRowCount,
+      "Output rows does not match expected: {}",
+      this->toString());
+#endif
+  // check if any rows in results are null. Use integer indexing and log
+  // container and row index where it occurs
+  uint64_t rowIdx = 0;
+  uint64_t containerIdx = 0;
+  for (auto& resultContainer : results) {
+    auto& rows = resultContainer->pin()->getRows();
+    for (auto& row : rows) {
+      BOLT_CHECK_NE(
+          row, nullptr, "nullptr in result container at row index {}", rowIdx);
+      rowIdx++;
+    }
+    containerIdx++;
+  }
+  auto merged = std::make_shared<OrderedContainer>(
+      currentRowCount, std::move(results), std::move(indexes));
+#ifndef NDEBUG
+  verifyContainerIsSorted(merged, op);
+#endif
+  return merged;
+}
+
+static std::vector<SortWork> getMergeJobs(
+    const std::shared_ptr<OrderedContainer>& a,
+    const std::shared_ptr<OrderedContainer>& b,
+    vector_size_t numPartitions,
+    const SortBufferMergePath* op) {
+  // If the total length of the combined vectors is less than our threshold,
+  // then we simply combine via a single thread. Otherwise, determine the total
+  // number of partitions then, calculate the merge path intersection points
+  // based on the merge path algorithm.
+
+  uint64_t minPartitions = std::min(
+      // generally numPartitions is small (on the range of cores in a single
+      // machine) so this cast up to uint64_t and back down to uint32_t later
+      // should be safe.
+      static_cast<uint64_t>(numPartitions),
+      a->totalRecords_ + b->totalRecords_);
+
+  uint32_t partitions =
+      std::max(static_cast<uint32_t>(1), static_cast<uint32_t>(minPartitions));
+  std::vector<std::pair<uint64_t, uint64_t>> mergePoints(partitions);
+  if (partitions > 1) {
+    std::pair<uint64_t, uint64_t> lastPoint = {0, 0};
+    for (uint32_t i = 0; i < partitions - 1;
+         i++) { // the final point is the end of the array.
+      mergePoints[i] =
+          calculatePartitionPoint_DDB(a, b, i, partitions, op, lastPoint);
+      lastPoint = mergePoints[i];
+#ifndef NDEBUG
+      // validate that mergePoints[i] is > than the previous iteration for both
+      // pairs.
+      // If it isn't then re-run the calculation for the previous and current
+      // pair. This will cause an infinite loop. In a correct implementation
+      // this should never occur.
+      if (i > 0 &&
+          (mergePoints[i].first < mergePoints[i - 1].first ||
+           mergePoints[i].second < mergePoints[i - 1].second)) {
+        LOG(ERROR)
+            << "Inconsistent merge point calculation. Re-running calculation for partition: "
+            << i << " with points: " << mergePoints[i].first << ", "
+            << mergePoints[i].second;
+        verifyContainerIsSorted(a, op);
+        verifyContainerIsSorted(b, op);
+        i -= 2;
+      }
+#endif
+    }
+    mergePoints[partitions - 1] = {a->totalRecords_, b->totalRecords_};
+  } else {
+    mergePoints[0] = {a->totalRecords_, b->totalRecords_};
+  }
+
+  uint32_t lastAPoint = 0;
+  uint32_t lastBPoint = 0;
+  std::vector<SortWork> sortJobs;
+  sortJobs.reserve(mergePoints.size());
+  for (auto& mergePoint : mergePoints) {
+    ArrayPartition nextAPartition = {
+        .minIdx = lastAPoint, .maxIdx = mergePoint.first};
+    ArrayPartition nextBPartition = {
+        .minIdx = lastBPoint, .maxIdx = mergePoint.second};
+    if (nextAPartition.maxIdx < nextAPartition.minIdx ||
+        nextBPartition.maxIdx < nextBPartition.minIdx) {
+      std::vector<std::string> formattedPoints;
+      formattedPoints.reserve(mergePoints.size());
+      for (const auto& p : mergePoints) {
+        formattedPoints.push_back(fmt::format("[{}, {}]", p.first, p.second));
+      }
+      std::string err = fmt::format(
+          "Invalid partition range for A: [{}, {}] for B: [{}, {}],"
+          "Full mergepoint arr: {}",
+          nextAPartition.minIdx,
+          nextAPartition.maxIdx,
+          nextBPartition.minIdx,
+          nextBPartition.maxIdx,
+          fmt::join(formattedPoints, ", "));
+      BOLT_USER_CHECK_GE(
+          nextAPartition.maxIdx, nextAPartition.minIdx, "{}", err);
+      BOLT_USER_CHECK_GE(
+          nextBPartition.maxIdx, nextBPartition.minIdx, "{}", err);
+    }
+    sortJobs.emplace_back(a, b, nextAPartition, nextBPartition, op);
+    lastAPoint = nextAPartition.maxIdx;
+    lastBPoint = nextBPartition.maxIdx;
+  }
+  return sortJobs;
+}
+
+void SortBufferMergePath::waitForPendingTasks() {
+  std::unique_lock<std::mutex> lock(addInputTasksMutex_);
+  addInputTasksCv_.wait(lock, [this]() { return pendingTasks_ == 0; });
+}
+
+void SortBufferMergePath::flushExistingVectors() {
+  // collect the remaining vectors, sort them, and then append them to the
+  // current vector.
+  if (!inputVectors_.vectors_.empty()) {
+    addSortTask(std::move(inputVectors_));
+  }
+
+  // make sure no more tasks from addInput are executing:
+  uint64_t usecs = 0;
+  {
+    MicrosecondTimer timer(&usecs);
+    waitForPendingTasks();
+  }
+  blockedOnSortingNoMoreInputTimer_ += usecs;
+}
+
+void SortBufferMergePath::noMoreInput() {
+  LOG(INFO) << "No more input called!";
+  {
+    MicrosecondTimer flushTimer(&sortStats_.sortColToRowTimeUs);
+    flushExistingVectors();
+  }
+  MicrosecondTimer iterationTime(&sortStats_.sortInSortTimeUs);
+  LOG(INFO) << "Finished flushing existing sort jobs";
+  // Parallel Sorting Algorithm
+  // Set up:
+  // assume all of our spilled containers are pre-sorted, create a stack of
+  // work
+  std::stack<std::shared_ptr<OrderedContainer>> orderedContainers;
+  for (const auto& container : containers_) {
+    auto orderedContainer = OrderedContainer::newContainer(container);
+    LOG(INFO) << "Starting container: " << orderedContainer->toString();
+    orderedContainers.push(orderedContainer);
+  }
+  // the original container are no longer required. Clear the vec to allow
+  // releasing sooner
+  containers_.clear();
+  // now we have a stack of ordered vectors.
+  // we merge them by combining two containers together until we only have a
+  // single sorted container
+
+  uint64_t iter = 0;
+  while (orderedContainers.size() > 1) {
+    iter++;
+
+    // gather all pairs of vectors, combine, and then push back to the stack.
+    std::vector<std::tuple<
+        std::shared_ptr<OrderedContainer>,
+        std::shared_ptr<OrderedContainer>>>
+        pairs;
+    while (orderedContainers.size() > 1) {
+      auto a = orderedContainers.top();
+      orderedContainers.pop();
+      auto b = orderedContainers.top();
+      orderedContainers.pop();
+      pairs.emplace_back(a, b);
+    }
+
+    // Submit all tasks to executor and collect futures
+    std::vector<folly::Future<std::shared_ptr<OrderedContainer>>> futures;
+    futures.reserve(pairs.size());
+    uint32_t maxParallelismPerPair =
+        std::max(static_cast<uint32_t>(parallelism_ / pairs.size()), 1U);
+
+    for (const auto& pair : pairs) {
+      auto task =
+          folly::via(
+              mergeExecutor_.get(),
+              [this, iter, maxParallelismPerPair, pair = std::move(pair)]() {
+                auto a = std::get<0>(pair);
+                auto b = std::get<1>(pair);
+                auto jobs = getMergeJobs(a, b, maxParallelismPerPair, this);
+#ifndef NDEBUG
+                auto pairRows = a->totalRecords_ + b->totalRecords_;
+                uint64_t totalRows = 0;
+                for (auto& job : jobs) {
+                  totalRows += job.aPart.maxIdx - job.aPart.minIdx +
+                      job.bPart.maxIdx - job.bPart.minIdx;
+                }
+                BOLT_CHECK_EQ(
+                    totalRows, pairRows, "changed row count on iter {}", iter);
+#endif
+                return jobs;
+              })
+              .thenValue([this](auto&& jobs) {
+                // Add the sort jobs to the executor and make a future which
+                // finishes once all sort jobs are complete.
+                std::vector<folly::Future<std::shared_ptr<OrderedContainer>>>
+                    jobFutures;
+                jobFutures.reserve(jobs.size());
+
+                for (auto& job : jobs) {
+                  auto jobPtr = std::make_shared<SortWork>(std::move(job));
+                  jobFutures.push_back(folly::via(
+                      mergeExecutor_.get(),
+                      [jobPtr]() { return jobPtr->merge(); }));
+                }
+
+                // At the end of that future, a new callback should run which
+                // executes the actual merge operation.
+                return folly::collectAll(jobFutures)
+                    .via(mergeExecutor_.get())
+                    .thenValue([](auto&& results) {
+                      std::vector<std::shared_ptr<OrderedContainer>> merged;
+                      merged.reserve(results.size());
+
+                      // Wait for all futures to complete and collect results in
+                      // order
+                      for (auto& result : results) {
+                        merged.push_back(std::move(result).value());
+                      }
+
+                      return OrderedContainer::merge(merged);
+                    });
+              });
+      futures.push_back(std::move(task));
+    }
+    auto merged = folly::collectAll(futures).get();
+
+    for (auto& container : merged) {
+      if (container.hasException()) {
+        auto& exception = container.exception();
+        LOG(ERROR) << "Merge Path failed. Task threw exception: "
+                   << exception.what();
+        exception.throw_exception();
+      }
+      orderedContainers.push(container.value());
+    }
+#ifndef NDEBUG
+    // verify total row count
+    uint64_t rowCount = 0;
+    auto tmpStack = orderedContainers;
+    while (!tmpStack.empty()) {
+      auto current = tmpStack.top();
+      rowCount += current->totalRecords_;
+      // Process current element
+      tmpStack.pop(); // This only affects the temporary copy
+    }
+    BOLT_CHECK_EQ(
+        rowCount, numInputRows_, "Increased row count on iter {}", iter);
+#endif
+  }
+
+  if (orderedContainers.size() == 1) {
+#ifndef NDEBUG
+    verifyContainerIsSorted(orderedContainers.top(), this);
+#endif
+    orderedContainers_ = std::deque(
+        orderedContainers.top()->sortedContainers_.begin(),
+        orderedContainers.top()->sortedContainers_.end());
+  } else if (orderedContainers.size() > 1) {
+    // no inputs
+    BOLT_FAIL(
+        "Must only have a single sorted container. Found {} containers",
+        orderedContainers.size());
+  }
+
+#ifndef NDEBUG
+  uint64_t rowCount = 0;
+  for (auto& item : orderedContainers_) {
+    rowCount += item->numRows();
+  }
+  BOLT_CHECK_EQ(rowCount, numInputRows_);
+#endif
+  noMoreInput_ = true;
+  pool_->release();
+}
+
+RowVectorPtr SortBufferMergePath::getOutput(uint32_t maxOutputRows) {
+  MicrosecondTimer iterationTime(&sortStats_.sortOutputTimeUs);
+  if (finished_ || !noMoreInput_) {
+    return nullptr;
+  }
+
+  if (currentOutputRows_.empty() ||
+      currentOutputRows_.size() - currentOutputContainerIndex_ <
+          maxOutputRows) {
+    std::vector<char*> currentRowBuffer;
+    currentRowBuffer.reserve(maxOutputRows);
+    currentRowBuffer.insert(
+        currentRowBuffer.end(),
+        currentOutputRows_.begin() + currentOutputContainerIndex_,
+        currentOutputRows_.end());
+    currentOutputContainerIndex_ = 0;
+    while (currentRowBuffer.size() < maxOutputRows) {
+      if (orderedContainers_.empty()) {
+        break;
+      }
+      auto container = orderedContainers_.front();
+      orderedContainers_.pop_front();
+      auto pinned = container->pin();
+      if (!estimatedOutputRowSize_.has_value()) {
+        estimatedOutputRowSize_ = pinned->getRowContainer()->estimateRowSize();
+      }
+      auto rows = pinned->exportRows();
+      currentRowBuffer.insert(
+          currentRowBuffer.end(), rows.data(), rows.data() + rows.size());
+    }
+    currentOutputRows_ = std::move(currentRowBuffer);
+  }
+  convertSpillableToRowVectorPtr(currentOutputRows_, maxOutputRows, pool_);
+  finished_ = output_ == nullptr;
+  if (finished_) {
+    return nullptr;
+  }
+
+  return output_;
+}
+
+void SortBufferMergePath::convertSpillableToRowVectorPtr(
+    const std::vector<char*>& rows,
+    uint64_t maxOutputRows,
+    MemoryPool* pool) {
+  if (rows.empty()) {
+    output_ = nullptr;
+    return;
+  }
+  auto remainingRows = rows.size() - currentOutputContainerIndex_;
+  auto outputRows = std::min(maxOutputRows, remainingRows);
+
+  // i is the index of the columns in the container, projectionMapping[i] is the
+  // index in the output vector
+  const auto& columnMap = rowContainer_->projectionMapping();
+  auto outputType = rowContainer_->inputType();
+  if (output_ != nullptr) {
+    VectorPtr output = std::move(output_);
+    BaseVector::prepareForReuse(output, outputRows);
+    output_ = std::static_pointer_cast<RowVector>(output);
+  } else {
+    output_ = std::static_pointer_cast<RowVector>(
+        BaseVector::create(outputType, outputRows, pool));
+  }
+
+  for (auto& child : output_->children()) {
+    child->resize(outputRows);
+  }
+
+  if (currentOutputContainerIndex_ < rows.size()) {
+    char* const* rowPtr = rows.data() + currentOutputContainerIndex_;
+    for (int i = 0; i < columnMap.size(); i++) {
+      rowContainer_->rowContainer()->extractColumn(
+          rowPtr, outputRows, i, output_->childAt(columnMap[i]));
+    }
+  }
+
+  currentOutputContainerIndex_ += outputRows;
+  numOutputRows_ += outputRows;
+  if (std::cmp_greater_equal(currentOutputContainerIndex_, rows.size())) {
+    currentOutputRows_ = {};
+    currentOutputContainerIndex_ = 0;
+  }
+}
+
+void SortBufferMergePath::close() {
+  rowContainer_.reset();
+}
+
+size_t SortBufferMergePath::numInputRows() {
+  return numInputRows_;
+}
+
+size_t SortBufferMergePath::numOutputRows() {
+  return numOutputRows_;
+}
+
+std::optional<uint64_t> SortBufferMergePath::estimateOutputRowSize() const {
+  return estimatedOutputRowSize_;
+}
+
+std::optional<common::SpillStats> SortBufferMergePath::spilledStats() const {
+  return std::nullopt;
+}
+std::optional<common::SpillReadStats> SortBufferMergePath::spillReadStats()
+    const {
+  return std::nullopt;
+}
+std::optional<common::SortStats> SortBufferMergePath::sortStats() const {
+  return sortStats_;
+}
+
+/**
+ * @brief Falls back to single-threaded sorting by creating a new SortBuffer
+ * instance.
+ *
+ * This method waits for all pending sorting tasks to complete and then creates
+ * a new SortBuffer object. It transfers the current row container
+ * to the new buffer and adds any remaining input vectors. Finally, it sets the
+ * number of input rows in the new buffer and returns the buffer.
+ *
+ * This fallback mechanism is used when the data used for sorting no longer fits
+ * in memory. The current multithreaded implementation does not support spilling
+ * to disk, so we must fall back to the single-threaded implementation that does
+ * support spilling.
+ *
+ * @return A pointer to an ISortBuffer object configured with the current
+ *         sorting parameters and containing all the collected input data.
+ */
+std::unique_ptr<ISortBuffer> SortBufferMergePath::fallbackToSingleThread() {
+  waitForPendingTasks();
+  auto buffer = std::make_unique<SortBuffer>(
+      inputType_,
+      sortColumnIndices_,
+      sortCompareFlags_,
+      pool_,
+      nonReclaimableSection_,
+      spillConfig_,
+      spillMemoryThreshold_,
+      operatorCtx_);
+  auto rowContainer = rowContainer_->release();
+  buffer->data_ = std::move(rowContainer);
+  for (auto& vec : inputVectors_.vectors_) {
+    buffer->addInput(vec);
+  }
+  buffer->numInputRows_ = numInputRows_;
+  return buffer;
+}
+
