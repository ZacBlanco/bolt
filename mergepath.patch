+class OrderByRowContainerTest : public OperatorTestBase {
+ public:
+  void TearDown() override {
+    OperatorTestBase::TearDown();
+    container_.reset();
+    pool_.reset();
+  }
+
+  void SetUp() override {
+    OperatorTestBase::SetUp();
+    pool_.reset();
+    container_.reset();
+    pool_ = memory::memoryManager()->addLeafPool();
+
+    rowType_ = ROW({{"c0", INTEGER()}, {"c1", VARCHAR()}});
+
+    sortColumnIndices_ = {0}; // Sort by first column (c0)
+    sortCompareFlags_ = {CompareFlags{true, true}}; // ASC, NULLS FIRST
+
+    spillConfig_ = {
+
+    };
+    container_ = std::make_unique<OrderByRowContainer>(
+        sortColumnIndices_,
+        sortCompareFlags_,
+        rowType_,
+        pool_.get(),
+        nullptr,
+        1024);
+  }
+
+  RowVectorPtr createTestData(int numRows) {
+    std::vector<int32_t> c0Values;
+    VectorFuzzer::Options opts;
+    opts.vectorSize = numRows;
+    opts.nullRatio = 0;
+    VectorFuzzer fuzzer(opts, pool(), 0);
+    return fuzzer.fuzzRow(ROW({INTEGER(), VARCHAR()}));
+  }
+
+  static void assertEqualVectorPart(
+      const VectorPtr& expected,
+      const VectorPtr& actual) {
+    ASSERT_GE(expected->size(), actual->size());
+    ASSERT_EQ(expected->typeKind(), actual->typeKind());
+    for (vector_size_t i = 0; i < actual->size(); i++) {
+      ASSERT_TRUE(expected->equalValueAt(actual.get(), i, i))
+          << "at " << (i) << ": expected " << expected->toString(i)
+          << ", but got " << actual->toString(i);
+    }
+  }
+
+  void assertPinnedEqual(
+      const std::shared_ptr<PinnedRowContainer>& pinnedContainer,
+      const RowVectorPtr& expected) {
+    auto rc = pinnedContainer->getRowContainer();
+    // verify the data is equal
+    auto& rows = pinnedContainer->getRows();
+    auto rowCount = rows.size();
+    for (int i = 0; i < expected->childrenSize(); i++) {
+      auto expectedColumn = expected->childAt(i);
+      auto actualColumn =
+          BaseVector::create(expectedColumn->type(), rowCount, pool_.get());
+      rc->extractColumn(
+          rows.data(), rowCount, rc->columnAt(i), 0, actualColumn, true);
+      assertEqualVectorPart(expectedColumn, actualColumn);
+    }
+  }
+
+  RowTypePtr rowType_;
+  std::vector<column_index_t> sortColumnIndices_;
+  std::vector<CompareFlags> sortCompareFlags_;
+  std::shared_ptr<memory::MemoryPool> pool_;
+  common::SpillConfig spillConfig_;
+  std::unique_ptr<OrderByRowContainer> container_;
+};
+
+TEST_F(OrderByRowContainerTest, PinWriteUnpin) {
+  auto testData = createTestData(5);
+  auto spillableContainer = container_->addVector(testData);
+  auto pinnedContainer = spillableContainer->pin();
+  auto rowContainer = pinnedContainer->getRowContainer();
+  assertPinnedEqual(pinnedContainer, testData);
+}
+
+// Disabled until OrderByRowContainer supports spilling again.
+TEST_F(OrderByRowContainerTest, DISABLED_WriteEvictRepin) {
+  auto testData = createTestData(10);
+  auto spillingContainer = container_->addVector(testData);
+
+  {
+    auto pinnedContainer = spillingContainer->pin();
+    assertPinnedEqual(pinnedContainer, testData);
+  }
+
+  {
+    auto largeData = createTestData(100); // Large enough to trigger eviction
+    ASSERT_EQ(container_->evictions(), 0);
+    auto largeContainer = container_->addVector(largeData);
+    auto largePinned = largeContainer->pin();
+    ASSERT_GT(container_->evictions(), 0);
+    assertPinnedEqual(largePinned, largeData);
+  }
+
+  auto repinnedContainer = spillingContainer->pin();
+  assertPinnedEqual(repinnedContainer, testData);
+}
+
+TEST_F(OrderByRowContainerTest, DoublePin) {
+  auto testData = createTestData(200);
+
+  auto spillingContainer = container_->addVector(testData);
+  auto pin1 = spillingContainer->pin();
+  auto pin2 = spillingContainer->pin();
+  ASSERT_EQ(pin1->getRowContainer(), pin2->getRowContainer());
+}
+
+// Create and pin a large number of containers to trigger lots of eviction
+// Disabled until we can support spilling
+TEST_F(OrderByRowContainerTest, DISABLED_ManyPins) {
+  auto containerCount = 256;
+  std::vector<std::shared_ptr<SpillableRowContainer>> containers;
+  std::vector<RowVectorPtr> testData;
+  for (int i = 0; i < containerCount; i++) {
+    testData.push_back(createTestData(5));
+    containers.push_back(container_->addVector(testData[i]));
+  }
+  BOLT_CHECK_GT(container_->evictions(), 0);
+  for (int i = 0; i < containerCount; i++) {
+    auto pin = containers[i]->pin();
+    assertPinnedEqual(pin, testData[i]);
+  }
+  // one eviction per container on creation, and then once per pin() call
+  // -2 because 2 containers fit without spilling
+  BOLT_CHECK_EQ(container_->evictions(), (containerCount * 2) - 2);
+}
