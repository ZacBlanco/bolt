+namespace bytedance::bolt::exec {
+
+class ISortBuffer {
+ public:
+  virtual void addInput(const VectorPtr& input) = 0;
+  virtual void noMoreInput() = 0;
+  virtual bytedance::bolt::RowVectorPtr getOutput(uint32_t maxOutputRows) = 0;
+  virtual void reclaim(uint64_t targetBytes) = 0;
+  // numInput rows, numOutputRows, estimateOutputRowSize
+  virtual std::optional<uint64_t> estimateOutputRowSize() const = 0;
+  virtual size_t numInputRows() = 0;
+  virtual size_t numOutputRows() = 0;
+  virtual std::optional<common::SpillStats> spilledStats() const = 0;
+  virtual std::optional<common::SpillReadStats> spillReadStats() const = 0;
+  virtual std::optional<common::SortStats> sortStats() const = 0;
+  virtual ~ISortBuffer() = default;
+  // Reserves space in the memory pool for the input vector.
+  static void reserveSpace(
+      const VectorPtr& input,
+      const RowContainer* container,
+      const common::SpillConfig* spillConfig,
+      memory::MemoryPool* pool,
+      tsan_atomic<bool>* nonReclaimableSection);
+  static bool willInputFit(
+      uint64_t numRows,
+      uint64_t spillMemoryThreshold,
+      memory::MemoryPool* pool,
+      const common::SpillConfig* spillConfig);
+
+ protected:
+  void computeJitCmpFunction(
+      RowContainer* data,
+      exec::OperatorCtx* operatorCtx,
+      const std::vector<CompareFlags>& sortCompareFlags);
+  RowRowCompare cmp_{nullptr};
+#ifdef ENABLE_BOLT_JIT
+  bolt::jit::CompiledModuleSP jitModule_;
+#endif
+};
+
+} // namespace bytedance::bolt::exec
