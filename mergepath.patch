+
+    const auto& projectionMapping = container->projectionMapping();
+    ASSERT_EQ(projectionMapping.size(), 3);
+    ASSERT_EQ(projectionMapping[0], 2); // c (sorted)
+    ASSERT_EQ(projectionMapping[1], 0); // a (non-sorted)
+    ASSERT_EQ(projectionMapping[2], 1); // b (non-sorted)
+  }
+
+  // (BIGINT a, BIGINT b, DOUBLE c) with sort keys on b and c (indices 1 and 2)
+  // Expected: [1, 2, 0]
+  {
+    auto inputType = ROW({{"a", BIGINT()}, {"b", BIGINT()}, {"c", DOUBLE()}});
+    std::vector<column_index_t> sortIndices = {1, 2};
+    std::vector<CompareFlags> sortFlags = {
+        CompareFlags{true, true}, CompareFlags{true, true}};
+
+    auto container = std::make_unique<OrderByRowContainer>(
+        sortIndices, sortFlags, inputType, pool_.get(), nullptr, 1024);
+
+    const auto& projectionMapping = container->projectionMapping();
+    ASSERT_EQ(projectionMapping.size(), 3);
+    ASSERT_EQ(projectionMapping[0], 1); // b (sorted first)
+    ASSERT_EQ(projectionMapping[1], 2); // c (sorted second)
+    ASSERT_EQ(projectionMapping[2], 0); // a (non-sorted)
+  }
+
+  // (BIGINT a, BIGINT b, DOUBLE c) with sort keys on a and b
+  // Expected: [0, 1, 2]
+  {
+    auto inputType = ROW({{"a", BIGINT()}, {"b", BIGINT()}, {"c", DOUBLE()}});
+    std::vector<column_index_t> sortIndices = {0, 1};
