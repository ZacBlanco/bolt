+namespace bytedance::bolt::exec {
+SortBufferMergePath::SortBufferMergePath(
+    const RowTypePtr& input,
+    const std::vector<column_index_t>& sortColumnIndices,
+    const std::vector<CompareFlags>& sortCompareFlags,
+    MemoryPool* pool,
+    tsan_atomic<bool>* nonReclaimableSection,
+    const core::QueryConfig* queryConfig,
+    OperatorCtx* operatorCtx,
+    // these parameters may be null
+    const common::SpillConfig* spillConfig,
+    std::shared_ptr<folly::Executor> mergeExecutor)
+    : inputType_(input),
+      sortColumnIndices_(sortColumnIndices),
+      nonReclaimableSection_(nonReclaimableSection),
+      queryConfig_(queryConfig),
+      spillMemoryThreshold_(queryConfig_->orderBySpillMemoryThreshold()),
+      spillConfig_(spillConfig),
+      operatorCtx_(operatorCtx),
+      parallelism_(
+          spillMemoryThreshold_ == 0 ? std::thread::hardware_concurrency()
+                                     : spillMemoryThreshold_),
+      inputVectors_({}),
+      inputVectorMemoryLimit_(
+          spillMemoryThreshold_ != 0 ? spillMemoryThreshold_ / parallelism_
+                                     : 256L << 20),
+      mergeExecutor_(std::move(mergeExecutor)) {
+  // minimum target memory is 1MB regardless of what user sets. Otherwise,
+  // if spilling is allowed, divide the spill memory threshold by 128 for higher
+  // parallelism. If it's not set, use a container target size of 128MB
+  targetContainerMemory_ = std::max(
+      1UL << 20,
+      spillMemoryThreshold_ == 0 ? 32UL << 20 : spillMemoryThreshold_ / 128);
+  sortCompareFlags_ = sortCompareFlags;
+  pool_ = pool;
+  sorter_ = HybridSorter();
+  BOLT_CHECK(pool_->trackUsage());
+  rowContainer_ = std::make_unique<OrderByRowContainer>(
+      sortColumnIndices,
+      sortCompareFlags,
+      input,
+      pool_,
+      spillConfig,
+      spillMemoryThreshold_);
+
+  auto* tmpContainer = rowContainer_->rowContainer();
+  variableColumns_ = computeRowColumns(*tmpContainer);
+  computeJitCmpFunction(
+      rowContainer_->rowContainer(), operatorCtx_, sortCompareFlags_);
+}
+
+// returns true if left < right
+static bool cmpLess(
+    const char* leftRow,
+    const char* rightRow,
+    RowContainer* rowContainer,
+    const std::vector<CompareFlags>& sortCompareFlags) {
+  for (vector_size_t index = 0; index < sortCompareFlags.size(); ++index) {
+    if (auto result = rowContainer->compare(
+            leftRow, rightRow, index, sortCompareFlags[index])) {
+      return result < 0;
+    }
+  }
+  return false;
+}
+
+static void sortPinned(
+    const std::shared_ptr<PinnedRowContainer>& pinned,
+    HybridSorter& sorter,
+    const std::vector<CompareFlags>& sortCompareFlags,
+    const RowRowCompare cmp) {
+  auto* container = pinned->getRowContainer();
+  auto& rows = pinned->getRows();
+  if (!cmp) {
+    sorter.template sort(
+        rows.begin(),
+        rows.end(),
+        [container, sortCompareFlags](
+            const char* leftRow, const char* rightRow) {
+          return cmpLess(leftRow, rightRow, container, sortCompareFlags);
+        });
+
+  } else {
+    sorter.template sort(
+        rows.begin(),
+        rows.end(),
+        [cmp](const char* leftRow, const char* rightRow) {
+          return cmp(leftRow, rightRow);
+        });
+  }
+}
+
+// returns < 0, 0, or >0 if the row at idx is <, =, or > than other_idx inside
+// of other aIdx and bIdx must be valid indexes into aPinned and bPinned
+// respectively.
+static bool compareLess(
+    uint64_t aIdx,
+    const std::shared_ptr<PinnedRowContainer>& aPinned,
+    uint64_t bIdx,
+    const std::shared_ptr<PinnedRowContainer>& bPinned,
+    const SortBufferMergePath*& op) {
+  char* rowA = aPinned->getRows()[aIdx];
+  char* rowB = bPinned->getRows()[bIdx];
+  if (op->cmp()) {
+    auto result = op->cmp()(rowA, rowB);
+    return result;
+  }
+  return aPinned->getRowContainer()->compareRows(
+             rowA, rowB, op->getSortCompareFlags()) < 0;
+}
+
+static bool compareLessGlobal(
+    uint64_t aGlobalIdx,
+    std::shared_ptr<OrderedContainer>& a,
+    uint64_t& aLastContainerIdx,
+    std::shared_ptr<PinnedRowContainer>& aCurrentPinned,
+    uint64_t bGlobalIdx,
+    std::shared_ptr<OrderedContainer>& b,
+    uint64_t& bLastContainerIdx,
+    std::shared_ptr<PinnedRowContainer>& bCurrentPinned,
+    const SortBufferMergePath*& op) {
+  auto [aContainerIdx, aCompareIdx] = a->getContainerIdx(aGlobalIdx);
+  auto [bContainerIdx, bCompareIdx] = b->getContainerIdx(bGlobalIdx);
+  auto aPinned = a->sortedContainers_[aContainerIdx]->pin();
+  auto bPinned = b->sortedContainers_[bContainerIdx]->pin();
+  BOLT_CHECK_LT(
+      aCompareIdx,
+      aPinned->getRows().size(),
+      "aCompareIdx out of container bounds: {}",
+      a->toString());
+  char* rowA = aPinned->getRows()[aCompareIdx];
+  BOLT_CHECK_LT(
+      bCompareIdx,
+      bPinned->getRows().size(),
+      "bCompareIdx out of container bounds: {}",
+      b->toString());
+  char* rowB = bPinned->getRows()[bCompareIdx];
+  if (op->cmp()) {
+    return op->cmp()(rowA, rowB);
+  }
+  auto& sortComplareFlags = op->getSortCompareFlags();
+  return cmpLess(rowA, rowB, aPinned->getRowContainer(), sortComplareFlags);
+}
+
+static bool verifyContainerIsSorted(
+    std::shared_ptr<OrderedContainer> a,
+    const SortBufferMergePath* op) {
+  std::shared_ptr<PinnedRowContainer> prevPin = a->sortedContainers_[0]->pin();
+  std::shared_ptr<PinnedRowContainer> currentPin;
+  bool sorted = true;
+  char* prevRow = nullptr;
+  for (auto& container : a->sortedContainers_) {
+    auto pinned = container->pin();
+    auto rowContainer = pinned->getRowContainer();
+    for (int i = 0; i < pinned->getRows().size(); i++) {
+      char* row = pinned->getRows()[i];
+      if (prevRow == nullptr) {
+        continue;
+      }
+      if (cmpLess(row, prevRow, rowContainer, op->getSortCompareFlags())) {
+        // checks if current row < prevRow
+        LOG(ERROR) << "Container is not sorted at index: " << i;
+        return false;
+      }
+      prevRow = row;
+    }
+  }
+  return sorted;
+}
+
+void SortBufferMergePath::addSortTask(const CollectedVectors&& vector) {
+  {
+    std::lock_guard lock(addInputTasksMutex_);
+    pendingTasks_++;
+  }
+
+  mergeExecutor_->add([vector, this]() {
+    auto container = rowContainer_->addVectors(vector.vectors_);
+    auto pinned = container->pin();
+    auto& rows = pinned->getRows();
+    for (int i = 0; i < rows.size(); i++) {
+      if (rows[i] == nullptr) {
+        BOLT_FAIL("Null row found at index {} before sorting", i);
+      }
+    }
+    sortPinned(pinned, sorter_, sortCompareFlags_, cmp_);
+    {
+      std::lock_guard<std::mutex> lock(containersLock_);
+      containers_.push_back(container);
+    }
+    // Decrement pending tasks and notify if all are complete
+    {
+      std::lock_guard lock(addInputTasksMutex_);
+      pendingTasks_--;
+      if (pendingTasks_ == 0) {
+        addInputTasksCv_.notify_one();
+      }
+    }
+  });
+}
+
+void SortBufferMergePath::addInput(const VectorPtr& input) {
+  // The vector must be loaded before potentially sending off to other
+  // threads for sorting. Readers aren't guaranteed to be thread-safe
+  input->loadedVector();
+  if (input->size() <= 0) {
+    return;
+  }
+  reserveSpace(
+      input,
+      rowContainer_->rowContainer(),
+      spillConfig_,
+      pool_,
+      nonReclaimableSection_);
+  CollectedVectors rowInput;
+  bool addTask = false;
+  {
+    std::lock_guard lock(addInputTasksMutex_);
+    vectorCount_++;
+    inputVectors_.vectors_.push_back(input);
+    inputVectors_.estimatedFlatSize_ += input->estimateFlatSize();
+    // check if we need to send the vector off for sorting.
+    // if so, send it off. Afterwards, set the new inputVector_ here to the new
+    // vector. Otherwise, append the new vector to the current one.
+    if (inputVectors_.estimatedFlatSize_ > inputVectorMemoryLimit_) {
+      rowInput = std::move(inputVectors_);
+      inputVectors_ = {};
+      addTask = true;
+    }
+  }
+  // separated due to locking
+  if (addTask) {
+    addSortTask(std::move(rowInput));
+  }
+
+  numInputRows_ += input->size();
+}
+
+void SortBufferMergePath::reclaim(uint64_t targetBytes) {
+  rowContainer_->reclaimMemory(targetBytes);
+}
