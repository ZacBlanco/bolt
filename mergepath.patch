+// A spillable RowContainer is a RowContainer which may either be in-memory or
+// on disk at any point. To access the underlying vector, use the `pin()` method
+// to prevent the vector from being spilled to disk. Pinning may force a read
+// from disk.
+class RowContainerRef {
+  friend class OrderByRowContainer;
+  friend class PinnedRowContainer;
+  friend class SpillableRowContainer;
+
+ public:
+  RowContainerRef(uint32_t id, uint64_t numRows, OrderByRowContainer* parent);
+  ~RowContainerRef();
+
+  // Pinning this container will remove it from the LRU list in
+  // OrderByRowContainer and return a PinnedRowContainer. When the final
+  // PinnedRowContainer is destroyed, the container will be returned to the
+  // front of the LRU list.
+  std::shared_ptr<PinnedRowContainer> pin();
+  uint64_t numRows() const {
+    return numRows_;
+  }
+
+ private:
+  std::string filePath() const;
+  void spillToDisk();
+  void loadFromDisk();
+  uint32_t id_;
+  uint64_t numRows_;
+  std::optional<OrderByRowContainer*> parent_;
+
+  // Any time we load from disk, create a reference to the row container. When
+  // the container is flushed to disk, this will be empty.
+  std::optional<std::shared_ptr<LoadedRowContainer>> rows_;
+
+  // We should only create one instance of the PinnedRowContainer for each
+  // RowContainerRef, use this ptr to see if an existing reference has already
+  // been pinned.
+  // std::weak_ptr<PinnedRowContainer> existingPin_;
+  std::atomic_uint32_t pinCount_{0};
+
+  // This represents the path to the file on disk for this container.
+  std::optional<SpilledBlockFile> spillFile_;
+
+  // This represents the next container in the LRU list.
+  std::weak_ptr<RowContainerRef> lruNext_;
+
+  // This represents the previous container in the LRU list.
+  std::weak_ptr<RowContainerRef> lruPrev_;
+
+  // the row type when spilled to disk.
+  RowTypePtr spillRowType_;
+  MemoryPool* spillMemoryPool_;
+
+  // lock is required for any operations that read or write this container.
+  std::recursive_mutex lock_;
+};
+
+// The OrderByRowContainer maintains a list of SpillableRowContainers. These
+// containers may be individually spilled or loaded from disk. Each container
+// holds a vector of row container pointers (char*). When spilled to disk, the
+// data contained in the pointers is written out to a file, and subsequently
+// read back into memory when pinned.
+// The usage pattern of this class is as follows:
+//
+// auto container = OrderByRowContainer::addVector()
+// auto pinned = container->pin();
+// auto rows = pinned->getRows();
+// char* row = rows[<i>];
+//
+// The lifetime of the "rows" and "row" variables have to be carefully managed
+// to ensure their lifetime does not outlive the reference to "pinned". Once
+// "pinned" goes out of scope there is no guarantee that the rows referenced by
+// the container will still be valid or point to the same data.
+//
+// The choice of which containers to write out to disk is managed by an LRU
+// list whose head and tail pointers are stored within the OrderByRowContainer.
+class OrderByRowContainer {
+  friend class RowContainerRef;
+  friend class PinnedRowContainer;
+
+ public:
+  OrderByRowContainer(
+      const std::vector<column_index_t>& sortColumnIndices,
+      const std::vector<CompareFlags>& sortCompareFlags,
+      const RowTypePtr& inputType,
+      MemoryPool* pool,
+      const common::SpillConfig* spillConfig,
+      uint64_t maxMemory);
+  ~OrderByRowContainer();
+  static std::vector<char*> addVectorToContainer(
+      const VectorPtr& input,
+      RowContainer* container,
+      std::mutex& rowContainerLock,
+      const std::vector<size_t>& projectionMapping);
+  // Adds a vector into this container and converts it into its own row
+  // container. May cause spilling
+  std::shared_ptr<SpillableRowContainer> addVector(const VectorPtr& rows);
+  std::shared_ptr<SpillableRowContainer> addVectors(
+      const std::vector<VectorPtr>& vectors);
+  // Adds an existing allocated rows from the RowContainer to the pool. May
+  // cause spilling.
+  std::shared_ptr<SpillableRowContainer> addToRowContainer(
+      std::vector<char*>&& allRows);
+  std::unique_ptr<RowContainer> emptyRowContainer();
+  RowContainer* rowContainer() {
+    return rowContainer_.get();
+  }
+  // Releases the container to the caller. Returns <container, numRows>. After
+  // this call the container is invalid and should no longer be used.
+  std::unique_ptr<RowContainer> release();
+
+  void releaseContainer(const std::shared_ptr<RowContainerRef>& container);
+
+  // prints a string representation of the LRU list.
+  std::string dumpLru();
+
+  // Attempt to reclaim memory by spilling existing vectors to disk.
+  //
+  // 'requiredBytes': the amount of memory we are seeking to reclaim
+  uint64_t reclaimMemory(uint64_t requiredBytes);
+  uint64_t evictions() const {
+    return evictions_;
+  }
+
+  uint64_t getMemoryUsage() {
+    return memoryCounter_;
+  }
+  const std::vector<size_t>& projectionMapping() {
+    return projectionMapping_;
+  }
+
+  const RowTypePtr& inputType() {
+    return inputType_;
+  }
+
+  const RowTypePtr& spillType() {
+    return spillType_;
+  }
+
+ private:
+  // pool which tracks memory allocations
+  bytedance::bolt::memory::MemoryPool* pool_;
+  uint64_t maxMemory_;
+  // The type that is expected of vectors in the addVector function
+  RowTypePtr inputType_;
+  // parent directory where spill files should go.
+  std::string spillPath_;
+  const common::SpillConfig* const spillConfig_;
+  // the storage type in the row container. Generally it is ( <sorted columns |
+  // <unsorted columns> )
+  RowTypePtr rowContainerType_;
+  // ordered list of the sorted columns as they appear in the row container
+  std::vector<TypePtr> sortedColumnTypes_;
+  // ordered list of the un-sorted fields as they appear in the row container
+  std::vector<TypePtr> nonSortedColumnTypes_;
+  // ordered vector where the index in the vector corresponds to the output
+  // type index. The value at a particular index is the input type position.
+  std::vector<size_t> projectionMapping_;
+  // type of vector spilled to disk.
+  RowTypePtr spillType_;
+  std::unique_ptr<RowContainer> rowContainer_;
+  std::mutex rowContainerLock_;
+
+  // Mapping of container ID to container.
+  std::unordered_map<uint64_t, std::shared_ptr<RowContainerRef>> containers_;
+
+  // LRU list pointers. This should only contain containers which are not
+  // spilled to disk.
+  // head is most-recently used
+  std::weak_ptr<RowContainerRef> head_;
+  // tail is least-recently used
+  std::weak_ptr<RowContainerRef> tail_;
+
+  // Add to head (most recent) of LRU list. Locks the class
+  void addToLRU(uint64_t id);
+  // Remove the node from the LRU list. Locks the class
+  void removeFromLRU(uint64_t id);
+  // Verifies that current memory usage is below the threshold. If it is above
+  // the maxMemory_ threshold, evicts items from the LRU list and spills them
+  // to disk. If maxMemory_ is 0, no spilling will occur, and reclamation will
+  // never happen.
+  // If reclamation must occur, locks the class.
+  void checkMemoryUsage();
+
+  // lock required when making modifications to containers_ or any part of the
+  // LRU list.
+  std::recursive_mutex lock_;
+  // mutex to prevent threads concurrently reclaiming memory
+  std::mutex reclaimLock_;
+  // incremented when a new container is allocated.
+  std::atomic<uint64_t> idCounter_;
+  // Used for tracking memory utilization
+  std::atomic<uint64_t> memoryCounter_;
+  // metrics
+  // number of container evictions (sometimes spilled to disk)
+  uint64_t evictions_;
+};
