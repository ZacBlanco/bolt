+TEST_F(OrderByRowContainerTest, projectionMapping) {
+  // (BIGINT a, BIGINT b, DOUBLE c) with sort key on a (index 0)
+  // Expected: [0, 1, 2]
+  {
+    auto inputType = ROW({{"a", BIGINT()}, {"b", BIGINT()}, {"c", DOUBLE()}});
+    std::vector<column_index_t> sortIndices = {0};
+    std::vector<CompareFlags> sortFlags = {
+        CompareFlags{.nullsFirst = true, .ascending = true}};
+
+    auto container = std::make_unique<OrderByRowContainer>(
+        sortIndices, sortFlags, inputType, pool_.get(), nullptr, 1024);
+
+    const auto& projectionMapping = container->projectionMapping();
+    ASSERT_EQ(projectionMapping.size(), 3);
+    ASSERT_EQ(projectionMapping[0], 0); // a (sorted)
+    ASSERT_EQ(projectionMapping[1], 1); // b (non-sorted)
+    ASSERT_EQ(projectionMapping[2], 2); // c (non-sorted)
+  }
+
+  // (BIGINT a, BIGINT b, DOUBLE c) with sort key on c (index 2)
+  // Expected: [2, 0, 1]
+  {
+    auto inputType = ROW({{"a", BIGINT()}, {"b", BIGINT()}, {"c", DOUBLE()}});
+    std::vector<column_index_t> sortIndices = {2};
+    std::vector<CompareFlags> sortFlags = {CompareFlags{true, true}};
+
+    auto container = std::make_unique<OrderByRowContainer>(
