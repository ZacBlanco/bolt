+std::vector<std::pair<bool, bytedance::bolt::exec::RowColumn>>
+computeRowColumns(const bytedance::bolt::exec::RowContainer& container) {
+  std::vector<std::pair<bool, bytedance::bolt::exec::RowColumn>>
+      variableColumns;
+  for (int i = 0; i < container.columnTypes().size(); i++) {
+    auto type = container.columnTypes()[i];
+    if (!type->isFixedWidth()) {
+      bool isStringType = type->kind() == bytedance::bolt::TypeKind::VARCHAR ||
+          type->kind() == bytedance::bolt::TypeKind::VARBINARY;
+      variableColumns.emplace_back(isStringType, container.columns()[i]);
+    }
+  }
+  return variableColumns;
+}
