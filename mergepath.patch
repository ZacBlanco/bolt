+      "🚀", // Emoji (4 bytes)
+      "abcdefghijklmnopqrstuvwxyz", // 26 chars
+      "测试字符串", // Chinese (5 characters, 15 bytes)
+      "hello world", // 11 chars
+      "1234567890", // 10 chars
+      "😀😃😄😁😆", // Multiple emojis
+      "This is a longer string with mixed content: 测试123!@#🚀",
+      std::string(50, 'x'), // 50 chars
+      "short",
+      "中文字符与emoji的混合测试🚀🚗🚲🏠",
+      "A", // Capital letter
+      "z", // Lowercase letter
+      "1", // Number
+      "9"};
+
+  // Create 8192 test strings by randomly selecting from the pool
+  constexpr size_t kNumStrings = 8192;
+  std::vector<std::string> testStrings;
+  testStrings.reserve(kNumStrings);
+  std::random_device rd;
+  std::mt19937 g(rd());
+  std::uniform_int_distribution<> distrib(0, testStringPool.size() - 1);
+
+  for (size_t i = 0; i < kNumStrings; ++i) {
+    testStrings.push_back(testStringPool[distrib(g)]);
+  }
+
+  // Shuffle the strings to ensure they're not already sorted
+  std::shuffle(testStrings.begin(), testStrings.end(), g);
+
+  // Create expected sorted results using std::sort
+  std::vector<std::string> expectedSorted = testStrings;
+  std::sort(expectedSorted.begin(), expectedSorted.end());
+
+  // Configure the sort buffer to sort by the varchar column (c5)
+  sortColumnIndices_ = {5};
+  std::unordered_map<std::string, std::string> configs = {
+      {core::QueryConfig::kJitLevel, "0"}};
+  auto queryConfig = core::QueryConfig({configs});
+
+  // Create sort buffer with ascending sort
+  std::vector<CompareFlags> sortCompareFlags = {
+      {true, true, false, CompareFlags::NullHandlingMode::kNullAsValue}};
+  auto sortBuffer = std::make_unique<SortBufferMergePath>(
+      inputType_,
+      sortColumnIndices_,
+      sortCompareFlags,
+      pool_.get(),
+      &nonReclaimableSection_,
+      &queryConfig,
+      nullptr,
+      nullptr,
+      executor_);
+
+  // Add each test string as a separate row vector
+  for (const auto& testStr : testStrings) {
+    RowVectorPtr rowVector = makeRowVector(
+        {makeFlatVector<int64_t>(std::vector<int64_t>({0})),
+         makeFlatVector<int32_t>(std::vector<int32_t>({0})),
+         makeFlatVector<int16_t>(std::vector<int16_t>({0})),
+         makeFlatVector<float>(std::vector<float>({0})),
+         makeFlatVector<double>(std::vector<double>({0})),
+         makeFlatVector<std::string>(std::vector<std::string>({testStr}))});
+    sortBuffer->addInput(rowVector);
+  }
+
+  // Signal no more input
+  sortBuffer->noMoreInput();
+
+  // Collect the output
+  VectorPtr baseOut = BaseVector::create(inputType_, 0, pool_.get());
+  auto output = baseOut->as<RowVector>();
+  while (auto out = sortBuffer->getOutput(10000)) {
+    output->append(out.get());
+  }
+
+  // Verify the output size matches the input size
+  ASSERT_EQ(output->size(), testStrings.size());
+
+  // Convert the output to a std::vector<std::string>
+  std::vector<std::string> actualSorted;
+  actualSorted.reserve(output->size());
+  auto stringVector = output->childAt(5)->asFlatVector<StringView>();
+  for (int i = 0; i < output->size(); ++i) {
+    actualSorted.push_back(stringVector->valueAt(i).str());
+  }
+
+  // Verify the sorted order matches the expected order
+  ASSERT_EQ(actualSorted.size(), expectedSorted.size());
+  for (size_t i = 0; i < actualSorted.size(); ++i) {
+    ASSERT_EQ(actualSorted[i], expectedSorted[i])
+        << "Strings differ at index " << i << ": "
+        << "expected '" << expectedSorted[i] << "', "
+        << "got '" << actualSorted[i] << "'";
+  }
+}
+} // namespace bytedance::bolt::functions::test
